rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isSmallImage() {
      return request.resource.size < 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Storage can't see Firestore by itself. firestore.get() reads the
    // user's document so we can check their role and team.
    function isTeamAdminOf(districtId, teamId) {
      let user = firestore.get(
        /databases/(default)/documents/districts/$(districtId)/users/$(request.auth.uid));
      return request.auth != null
        && user != null
        && user.data.role == 'teamAdmin'
        && user.data.teamId == teamId;
    }

    // Team request logo
    match /districts/{districtId}/teamRequests/{uid}/logo.jpg {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && isSmallImage();
      allow delete: if isOwner(uid);
    }

    // A new club's letter to the chairman, and the optional licence
    // (photo or PDF), up to 5 MB (2.13)
    match /districts/{districtId}/teamRequests/{uid}/{fileName} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.size < 5 * 1024 * 1024
        && ((fileName in ['letter.pdf', 'licence.pdf']
              && request.resource.contentType == 'application/pdf')
            || (fileName == 'licence.jpg'
              && request.resource.contentType.matches('image/.*')));
    }

    // Kit photos (2.13b): e.g. kits/division-home-shirt-1730000000000.jpg
    match /districts/{districtId}/teamRequests/{uid}/kits/{fileName} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid)
        && fileName.matches('(division|juvenile)-(home|away|third|goalkeeper|goalkeeper2)-(shirt|shorts|socks)-[0-9]+[.]jpg')
        && isSmallImage();
    }

    // Player passport photos: photo-<time>.jpg and thumb-<time>.jpg
    match /districts/{districtId}/teams/{teamId}/players/{playerId}/{fileName} {
      allow read, delete: if isTeamAdminOf(districtId, teamId);
      allow create: if isTeamAdminOf(districtId, teamId)
        && fileName.matches('(photo|thumb)-[0-9]+[.]jpg')
        && request.resource.size < 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
    }

    // Everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
