rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasConfirmedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function isOptionalText(data, field, max) {
      return !(field in data)
        || data[field] == null
        || (data[field] is string && data[field].size() <= max);
    }

    match /districts/{districtId} {

      // ---------- Paths ----------

      function teamNameDoc(key) {
        return /databases/$(database)/documents/districts/$(districtId)/teamNames/$(key);
      }

      function teamRequestDoc(uid) {
        return /databases/$(database)/documents/districts/$(districtId)/teamRequests/$(uid);
      }

      function userDoc(uid) {
        return /databases/$(database)/documents/districts/$(districtId)/users/$(uid);
      }

      function playerDoc(playerId) {
        return /databases/$(database)/documents/districts/$(districtId)/players/$(playerId);
      }

      function jerseyDoc(teamId, jerseyId) {
        return /databases/$(database)/documents/districts/$(districtId)/teams/$(teamId)/jerseys/$(jerseyId);
      }

      function playerKeyDoc(key) {
        return /databases/$(database)/documents/districts/$(districtId)/playerKeys/$(key);
      }

      // 'division-10' for a player's data
      function jerseyIdOf(data) {
        return data.category + '-' + string(data.jerseyNo);
      }

      // ---------- Roles ----------

      // True if the signed-in person is the team admin of this team
      function isTeamAdminOf(teamId) {
        return isSignedIn()
          && exists(userDoc(request.auth.uid))
          && get(userDoc(request.auth.uid)).data.get('role', '') == 'teamAdmin'
          && get(userDoc(request.auth.uid)).data.get('teamId', '') == teamId;
      }

            function teamDoc(teamId) {
        return /databases/$(database)/documents/districts/$(districtId)/teams/$(teamId);
      }

      // Position code → group. Must match position.dart
      function positionGroups() {
        return {
          'GK': 'GK',
          'CB': 'DEF', 'RCB': 'DEF', 'LCB': 'DEF', 'RB': 'DEF', 'LB': 'DEF',
          'RWB': 'DEF', 'LWB': 'DEF', 'RFB': 'DEF', 'LFB': 'DEF',
          'DM': 'MID', 'RDM': 'MID', 'LDM': 'MID', 'CM': 'MID',
          'RM': 'MID', 'LM': 'MID', 'AMF': 'MID',
          'LW': 'FWD', 'RW': 'FWD', 'LWF': 'FWD', 'RWF': 'FWD',
          'CF': 'FWD', 'ST': 'FWD'
        };
      }

      // The fields a team admin may write on a player
      function isValidPlayer(data) {
        return data.keys().hasOnly([
            'teamId', 'teamName', 'category', 'fullName', 'fullNameLower',
            'searchKeys', 'dob', 'position', 'positionGroup', 'jerseyNo',
            'photoUrl', 'thumbUrl', 'status', 'playerCode', 'rejectionReason',
            'createdAt', 'updatedAt', 'approvedAt', 'approvedBy', 'playerKey',
            'reviewedAt', 'reviewedBy', 'changes'
          ])
          // What the team changed since the FA last saw the player (2.3c),
          // e.g. {jerseyNo: {from: '#10', to: '#14'}}. Shown to the FA.
          && (!('changes' in data) || (data.changes is map && data.changes.size() <= 8))
          && isText(data.fullName, 3, 80)
          && data.fullNameLower == data.fullName.lower()
          && data.searchKeys is list
          && data.searchKeys.size() <= 80
          && data.playerKey is string
          && data.playerKey.size() <= 120
          && data.teamName is string
          && data.category in ['division', 'juvenile']
          && data.dob is timestamp
          && data.dob < request.time
          && data.position in positionGroups()
          && positionGroups()[data.position] == data.positionGroup
          && data.jerseyNo is int
          && data.jerseyNo >= 1
          && data.jerseyNo <= 99
          && isText(data.photoUrl, 10, 2000)
          && isText(data.thumbUrl, 10, 2000)
      }

      // An FA admin of this district (the chairman and the officials he appoints)
      function isFaAdmin() {
        return isSignedIn()
          && exists(userDoc(request.auth.uid))
          && get(userDoc(request.auth.uid)).data.get('role', '') == 'faAdmin';
      }

      // Any team admin (of any team)
      function isTeamAdmin() {
        return isSignedIn()
          && exists(userDoc(request.auth.uid))
          && get(userDoc(request.auth.uid)).data.get('role', '') == 'teamAdmin';
      }

      // The player's reservations exist and point back to this player
      function hasReservations(data, playerId) {
        return getAfter(jerseyDoc(data.teamId, jerseyIdOf(data))).data.playerId == playerId
          && getAfter(playerKeyDoc(data.playerKey)).data.playerId == playerId;
      }

      // ---------- Invitations (2.6) ----------

      function inviteDoc(inviteId) {
        return /databases/$(database)/documents/districts/$(districtId)/invites/$(inviteId);
      }

      // The chairman: an FA admin with isChairman: true (set by hand once)
      function isChairman() {
        return isFaAdmin()
          && get(userDoc(request.auth.uid)).data.get('isChairman', false) == true;
      }

      // My confirmed email in lower case = the ID of my invitation
      function myEmail() {
        return request.auth.token.email.lower();
      }

      // An invitation I may still accept: for my confirmed email,
      // pending and not expired
      function isMyOpenInvite(inviteId) {
        return hasConfirmedEmail()
          && request.auth.token.email is string
          && inviteId == myEmail()
          && exists(inviteDoc(inviteId))
          && get(inviteDoc(inviteId)).data.status == 'pending'
          && get(inviteDoc(inviteId)).data.expiresAt > request.time;
      }

      // ---------- users/{uid} ----------
      match /users/{uid} {
        allow get: if isOwner(uid) || isFaAdmin();

        // People and roles: the FA lists FA admins and referees
        allow list: if isFaAdmin();

        // Accepting an invitation: I create my own user document with the
        // role from my invitation, in the same batch that marks the
        // invitation accepted. One role per account (create, not update).
        allow create: if isOwner(uid)
          && isMyOpenInvite(request.resource.data.inviteId)
          && request.resource.data.keys().hasOnly(['role', 'name', 'email', 'inviteId', 'createdAt'])
          && request.resource.data.role == get(inviteDoc(request.resource.data.inviteId)).data.role
          && request.resource.data.email == myEmail()
          && isText(request.resource.data.name, 1, 80)
          && request.resource.data.createdAt == request.time
          && getAfter(inviteDoc(request.resource.data.inviteId)).data.status == 'accepted'
          && getAfter(inviteDoc(request.resource.data.inviteId)).data.acceptedBy == uid;

        // Removing a role: the chairman removes FA officials, any FA admin
        // removes referees. Nobody removes themselves, and the chairman's
        // role can't be removed in the app (so there is always an FA admin).
        allow delete: if isFaAdmin()
          && uid != request.auth.uid
          && resource.data.get('isChairman', false) != true
          && (resource.data.role == 'referee'
              || (resource.data.role == 'faAdmin' && isChairman()));

        // FA approves a team: the club's account becomes its team admin.
        // Only 'teamAdmin' can be given here (never 'faAdmin'), only to an
        // admin listed on the team created in the same batch, and only to
        // someone with no role yet (create, not update).
        allow create: if isFaAdmin()
          && request.resource.data.keys().hasOnly(['role', 'teamId', 'createdAt', 'createdBy'])
          && request.resource.data.role == 'teamAdmin'
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && getAfter(teamDoc(request.resource.data.teamId)).data.adminUids.hasAny([uid]);
      }

      // ---------- invites/{email} ----------
      // The document ID is the invited email in lower case, so the invited
      // person can find their invitation with one get, and an email has at
      // most one invitation at a time.
      match /invites/{inviteId} {
        allow get: if isFaAdmin()
          || (hasConfirmedEmail()
              && request.auth.token.email is string
              && inviteId == myEmail());
        allow list: if isFaAdmin();

        // Create: FA officials invite referees; only the chairman invites
        // FA officials. Expires in 14 days (a day either way for clocks).
        allow create: if isFaAdmin()
          && request.resource.data.keys().hasOnly([
               'email', 'name', 'role', 'status', 'invitedBy', 'invitedByName',
               'createdAt', 'expiresAt'
             ])
          && request.resource.data.email == inviteId
          && inviteId.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
          && isText(request.resource.data.name, 3, 80)
          && (request.resource.data.role == 'referee'
              || (request.resource.data.role == 'faAdmin' && isChairman()))
          && request.resource.data.status == 'pending'
          && request.resource.data.invitedBy == request.auth.uid
          && isText(request.resource.data.invitedByName, 1, 80)
          && request.resource.data.createdAt == request.time
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt > request.time + duration.value(13, 'd')
          && request.resource.data.expiresAt < request.time + duration.value(15, 'd');

        // Accept: only the invited person, while it is open, and only
        // together with creating their user document with that role.
        allow update: if isMyOpenInvite(inviteId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'acceptedBy', 'acceptedAt'])
          && request.resource.data.status == 'accepted'
          && request.resource.data.acceptedBy == request.auth.uid
          && request.resource.data.acceptedAt == request.time
          && getAfter(userDoc(request.auth.uid)).data.role == resource.data.role;

        // Cancel (FA, same who-can-invite rule), decline (the invited person),
        // or clear an accepted one when the role is removed (FA).
        allow delete: if (isFaAdmin()
              && (resource.data.role == 'referee' || isChairman()))
          || (hasConfirmedEmail()
              && request.auth.token.email is string
              && inviteId == myEmail()
              && resource.data.status == 'pending');
      }

      // ---------- roleLog/{entryId} ----------
      // Role history. Written in the same batch as each change; never
      // edited or deleted.
      match /roleLog/{entryId} {
        allow list, get: if isFaAdmin();
        allow create: if request.resource.data.keys().hasOnly([
               'email', 'name', 'role', 'action', 'uid', 'by', 'byName', 'at'
             ])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.at == request.time
          && request.resource.data.role in ['faAdmin', 'referee']
          && isText(request.resource.data.email, 3, 120)
          && isText(request.resource.data.byName, 1, 80)
          && ((isFaAdmin()
                && request.resource.data.action in ['invited', 'cancelled', 'removed'])
              || (hasConfirmedEmail()
                && request.auth.token.email is string
                && request.resource.data.email == myEmail()
                && request.resource.data.action in ['accepted', 'declined']));
      }

      // ---------- teamRequests/{uid} ----------
      function isValidTeamRequest(data, uid) {
        return data.keys().hasOnly([
            'teamName', 'teamNameLower', 'nameKey', 'shortName', 'town',
            'homeGround', 'categories', 'homeGroundDirections', 'yearFounded', 'email',
            'logoUrl', 'kits', 'officials', 'agreedToRules', 'status',
            'rejectionReason', 'createdAt', 'updatedAt',
            'reviewedAt', 'reviewedBy', 'teamId'
          ])
          && isText(data.teamName, 2, 60)
          && data.teamNameLower == data.teamName.lower()
          && data.nameKey is string
          && data.nameKey.matches('^[a-z0-9-]{2,60}$')
          && data.shortName is string
          && data.shortName.matches('^[A-Z]{3,4}$')
          && isText(data.town, 2, 60)
          && isText(data.homeGround, 2, 80)
          && isOptionalText(data, 'homeGroundDirections', 300)
          && isOptionalText(data, 'email', 120)
          && isOptionalText(data, 'logoUrl', 2000)
          && data.categories is list
          && data.categories.size() >= 1
          && data.categories.size() <= 2
          && data.categories.hasOnly(['division', 'juvenile'])
          && data.categories.toSet().size() == data.categories.size()
          && (!('yearFounded' in data) || data.yearFounded == null
              || (data.yearFounded is int
                  && data.yearFounded >= 1900 && data.yearFounded <= 2100))
          && data.kits is map
          && data.kits.keys().hasAll(['home', 'away', 'goalkeeper'])
          && data.kits.keys().hasOnly(['home', 'away', 'third', 'goalkeeper', 'goalkeeper2'])
          && data.officials is list
          && data.officials.size() >= 2
          && data.officials.size() <= 10
          && data.agreedToRules == true
          && data.status == 'pending'
          && (!('rejectionReason' in data) || data.rejectionReason == null)
          && data.updatedAt == request.time
          && getAfter(teamNameDoc(data.nameKey)).data.uid == uid;
      }

      // FA approves: only the review fields change. In the same batch the
      // team is created and the club's account becomes its team admin.
      function isApproval(uid) {
        let after = request.resource.data;
        return after.status == 'approved'
          && after.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'teamId', 'reviewedAt', 'reviewedBy', 'updatedAt'])
          && after.teamId == resource.data.nameKey
          && getAfter(teamDoc(after.teamId)).data.requestUid == uid
          && getAfter(userDoc(uid)).data.role == 'teamAdmin'
          && getAfter(userDoc(uid)).data.teamId == after.teamId;
      }

      // FA rejects: status and a real reason (10 to 500 characters).
      function isRejection() {
        let after = request.resource.data;
        return after.status == 'rejected'
          && after.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'rejectionReason', 'reviewedAt', 'reviewedBy', 'updatedAt'])
          && isText(after.rejectionReason, 10, 500);
      }

      match /teamRequests/{uid} {
        allow get: if isOwner(uid) || isFaAdmin();
        allow list: if isFaAdmin();

        allow create: if isOwner(uid)
          && hasConfirmedEmail()
          && isValidTeamRequest(request.resource.data, uid)
          && !request.resource.data.keys().hasAny(['reviewedAt', 'reviewedBy', 'teamId'])
          && request.resource.data.createdAt == request.time;

        // The club edits its own request (pending or rejected).
        // It can never touch the FA's review fields.
        allow update: if isOwner(uid)
          && hasConfirmedEmail()
          && resource.data.status in ['pending', 'rejected']
          && isValidTeamRequest(request.resource.data, uid)
          && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['reviewedAt', 'reviewedBy', 'teamId'])
          && request.resource.data.createdAt == resource.data.createdAt;

        // The FA approves or rejects a pending request.
        allow update: if isFaAdmin()
          && resource.data.status == 'pending'
          && request.resource.data.reviewedBy == request.auth.uid
          && request.resource.data.reviewedAt == request.time
          && request.resource.data.updatedAt == request.time
          && (isApproval(uid) || isRejection());
      }

      // ---------- teamNames/{nameKey} ----------
      match /teamNames/{nameKey} {
        allow get: if isSignedIn();

        allow create: if isOwner(request.resource.data.uid)
          && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
          && request.resource.data.createdAt == request.time
          && getAfter(teamRequestDoc(request.auth.uid)).data.nameKey == nameKey;

        allow delete: if isOwner(resource.data.uid)
          && (!existsAfter(teamRequestDoc(request.auth.uid))
              || getAfter(teamRequestDoc(request.auth.uid)).data.nameKey != nameKey);
      }

            // ---------- teams/{teamId} ----------
      match /teams/{teamId} {
        allow get: if isTeamAdminOf(teamId) || isFaAdmin();
        allow list: if isFaAdmin();

        // FA approves a request: the team is created from it, in the same
        // batch as the approval. Its ID is the reserved team-name key.
        allow create: if isFaAdmin()
          && request.resource.data.requestUid is string
          && request.resource.data.nameKey == teamId
          && request.resource.data.adminUids == [request.resource.data.requestUid]
          && get(teamNameDoc(teamId)).data.uid == request.resource.data.requestUid
          && getAfter(teamRequestDoc(request.resource.data.requestUid)).data.status == 'approved'
          && getAfter(teamRequestDoc(request.resource.data.requestUid)).data.teamId == teamId
          && request.resource.data.createdAt == request.time;

        // ---------- teams/{teamId}/jerseys/{jerseyId} ----------
        match /jerseys/{jerseyId} {
          allow get: if isTeamAdminOf(teamId) || isFaAdmin();

          allow create: if isTeamAdminOf(teamId)
            && request.resource.data.keys().hasOnly(['playerId', 'createdAt'])
            && request.resource.data.createdAt == request.time
            && getAfter(playerDoc(request.resource.data.playerId)).data.teamId == teamId
            && jerseyIdOf(getAfter(playerDoc(request.resource.data.playerId)).data) == jerseyId;

          allow delete: if isTeamAdminOf(teamId)
            && (!existsAfter(playerDoc(resource.data.playerId))
                || jerseyIdOf(getAfter(playerDoc(resource.data.playerId)).data) != jerseyId);
        }

        // ---------- teams/{teamId}/armbands/{category} (2.3d) ----------
        // One captain and one vice-captain per squad. One document per
        // competition, so there can never be two captains.
        function isArmbandHolder(id, category) {
          return id == null
            || (get(playerDoc(id)).data.teamId == teamId
                && get(playerDoc(id)).data.category == category);
        }

        match /armbands/{category} {
          allow get: if isTeamAdminOf(teamId) || isFaAdmin();
          allow create, update: if isTeamAdminOf(teamId)
            && category in ['division', 'juvenile']
            && request.resource.data.keys().hasOnly(['captainId', 'viceCaptainId', 'updatedAt'])
            && isArmbandHolder(request.resource.data.get('captainId', null), category)
            && isArmbandHolder(request.resource.data.get('viceCaptainId', null), category)
            && (request.resource.data.get('captainId', null) == null
                || request.resource.data.get('captainId', null)
                     != request.resource.data.get('viceCaptainId', null))
            && request.resource.data.updatedAt == request.time;
        }
      }

      // ---------- playerProfiles/{playerId} (2.3d) ----------
      // Football details the team keeps up to date: no FA approval, and
      // they never change the player's registration. Private: the team
      // and the FA only (the emergency contact is in here).
      function isValidProfile(data, playerId) {
        return data.keys().hasOnly([
            'teamId', 'heightCm', 'weightKg', 'foot', 'otherPositions',
            'strengths', 'hometown', 'clubSince', 'previousClub',
            'availability', 'unavailableReason', 'expectedBack', 'availabilityAt',
            'emergencyName', 'emergencyPhone', 'updatedAt'
          ])
          && data.teamId == get(playerDoc(playerId)).data.teamId
          && (data.get('heightCm', null) == null
              || (data.heightCm is int && data.heightCm >= 120 && data.heightCm <= 220))
          && (data.get('weightKg', null) == null
              || (data.weightKg is int && data.weightKg >= 35 && data.weightKg <= 130))
          && (data.get('foot', null) == null || data.foot in ['left', 'right', 'both'])
          && (data.get('otherPositions', []) is list
              && data.get('otherPositions', []).size() <= 2
              && positionGroups().keys().hasAll(data.get('otherPositions', [])))
          && (data.get('strengths', []) is list
              && data.get('strengths', []).size() <= 3
              && ['pace', 'strength', 'stamina', 'dribbling', 'passing', 'finishing',
                  'heading', 'tackling', 'setPieces', 'leadership']
                   .hasAll(data.get('strengths', [])))
          && isOptionalText(data, 'hometown', 60)
          && isOptionalText(data, 'previousClub', 80)
          && (data.get('clubSince', null) == null
              || (data.clubSince is int && data.clubSince >= 1980
                  && data.clubSince <= request.time.year()))
          && data.availability in ['available', 'injured', 'unavailable']
          && (data.get('unavailableReason', null) == null
              || (data.availability == 'unavailable'
                  && data.unavailableReason in ['away', 'family', 'workOrSchool',
                                                'clubDiscipline', 'other']))
          && (data.get('expectedBack', null) == null || data.expectedBack is timestamp)
          && data.availabilityAt is timestamp
          && isOptionalText(data, 'emergencyName', 80)
          && isOptionalText(data, 'emergencyPhone', 20)
          && data.updatedAt == request.time;
      }

      match /playerProfiles/{playerId} {
        // (a profile not filled in yet doesn't exist: any team admin may
        // look, and finds nothing)
        allow read: if isFaAdmin()
          || (resource == null && isTeamAdmin())
          || isTeamAdminOf(resource.data.teamId);
        allow create, update: if isTeamAdminOf(request.resource.data.teamId)
          && isValidProfile(request.resource.data, playerId)
          && (resource == null || resource.data.teamId == request.resource.data.teamId);
      }

      // ---------- playerKeys/{key} ----------
      match /playerKeys/{key} {
        allow get: if isTeamAdmin() || isFaAdmin();

        allow create: if isTeamAdminOf(request.resource.data.teamId)
          && request.resource.data.keys().hasOnly(['playerId', 'teamId', 'createdAt'])
          && request.resource.data.createdAt == request.time
          && getAfter(playerDoc(request.resource.data.playerId)).data.playerKey == key
          && getAfter(playerDoc(request.resource.data.playerId)).data.teamId
               == request.resource.data.teamId;

        allow delete: if isTeamAdminOf(resource.data.teamId)
          && (!existsAfter(playerDoc(resource.data.playerId))
              || getAfter(playerDoc(resource.data.playerId)).data.playerKey != key);
      }

      // ---------- settings/playerCounter ----------
      // The next player-ID number. Only moves forward, one at a time,
      // inside the FA's approval transaction.
      function counterDoc() {
        return /databases/$(database)/documents/districts/$(districtId)/settings/playerCounter;
      }

      // The number the next approved player gets (1 if no counter yet)
      function nextNumber() {
        return exists(counterDoc()) ? get(counterDoc()).data.next : 1;
      }

      // 43 in 2026 -> 'GE26-0043'. Must match player_code.dart.
      function playerCodeFor(n) {
        return 'GE' + string(request.time.year() % 100) + '-'
          + (n < 10 ? '000' : (n < 100 ? '00' : (n < 1000 ? '0' : '')))
          + string(n);
      }

      match /settings/playerCounter {
        allow get: if isFaAdmin();
        allow create: if isFaAdmin()
          && request.resource.data.keys().hasOnly(['next'])
          && request.resource.data.next == 2;
        allow update: if isFaAdmin()
          && request.resource.data.keys().hasOnly(['next'])
          && request.resource.data.next == resource.data.next + 1;
      }

      // ---------- FA review of players ----------

      // Approve: status, ID and approval stamp only.
      // - A player who already has an ID (approved before, then edited)
      //   keeps it.
      // - A first approval takes the counter's number, and the counter moves
      //   on by exactly 1 in the same transaction.
      function isPlayerApproval() {
        let before = resource.data;
        let after = request.resource.data;
        return after.status == 'approved'
          && after.diff(before).affectedKeys()
               .hasOnly(['status', 'playerCode', 'approvedAt', 'approvedBy',
                         'rejectionReason', 'updatedAt', 'changes'])
          && !('changes' in after)      // reviewed: the change list is cleared
          && after.approvedBy == request.auth.uid
          && after.approvedAt == request.time
          && after.get('rejectionReason', null) == null
          && ((before.get('playerCode', null) != null
                && after.playerCode == before.playerCode)
              || (before.get('playerCode', null) == null
                && after.playerCode == playerCodeFor(nextNumber())
                && getAfter(counterDoc()).data.next == nextNumber() + 1));
      }

      // Reject: status and a real reason (10 to 500 characters).
      function isPlayerRejection() {
        let after = request.resource.data;
        return after.status == 'rejected'
          && after.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'rejectionReason', 'reviewedAt', 'reviewedBy',
                         'updatedAt', 'changes'])
          && !('changes' in after)      // reviewed: the change list is cleared
          && isText(after.rejectionReason, 10, 500)
          && after.reviewedBy == request.auth.uid
          && after.reviewedAt == request.time;
      }

      // ---------- players/{playerId} ----------
      match /players/{playerId} {
        allow read: if isTeamAdminOf(resource.data.teamId) || isFaAdmin();

        // The FA approves or rejects a pending player.
        allow update: if isFaAdmin()
          && resource.data.status == 'pending'
          && request.resource.data.updatedAt == request.time
          && (isPlayerApproval() || isPlayerRejection());

        // The team adds and edits its own players.
        allow create: if isTeamAdminOf(request.resource.data.teamId)
          && isValidPlayer(request.resource.data)
          && hasReservations(request.resource.data, playerId)
          && request.resource.data.category == 'division'
          && get(teamDoc(request.resource.data.teamId)).data.categories
               .hasAny([request.resource.data.category])
          && request.resource.data.status == 'pending'
          && !('playerCode' in request.resource.data)
          && !('approvedAt' in request.resource.data)
          && !('approvedBy' in request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if isTeamAdminOf(resource.data.teamId)
          && isValidPlayer(request.resource.data)
          && hasReservations(request.resource.data, playerId)
          && request.resource.data.teamId == resource.data.teamId
          && request.resource.data.category == resource.data.category
          && request.resource.data.get('playerCode', null) == resource.data.get('playerCode', null)
          && request.resource.data.get('approvedAt', null) == resource.data.get('approvedAt', null)
          && request.resource.data.get('approvedBy', null) == resource.data.get('approvedBy', null)
          && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['reviewedAt', 'reviewedBy'])
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && (request.resource.data.status == 'pending'
              || (resource.data.status == 'approved'
                  && request.resource.data.status == 'approved'
                  && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['position', 'positionGroup', 'updatedAt'])));
      }
    } // end of districts/{districtId}

    // ---------- Everything else ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}