rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasConfirmedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function isOptionalText(data, field, max) {
      return !(field in data)
        || data[field] == null
        || (data[field] is string && data[field].size() <= max);
    }

    match /districts/{districtId} {

      // ---------- Paths ----------

      function teamNameDoc(key) {
        return /databases/$(database)/documents/districts/$(districtId)/teamNames/$(key);
      }

      function teamRequestDoc(uid) {
        return /databases/$(database)/documents/districts/$(districtId)/teamRequests/$(uid);
      }

      function userDoc(uid) {
        return /databases/$(database)/documents/districts/$(districtId)/users/$(uid);
      }

      function playerDoc(playerId) {
        return /databases/$(database)/documents/districts/$(districtId)/players/$(playerId);
      }

      function jerseyDoc(teamId, jerseyId) {
        return /databases/$(database)/documents/districts/$(districtId)/teams/$(teamId)/jerseys/$(jerseyId);
      }

      function playerKeyDoc(key) {
        return /databases/$(database)/documents/districts/$(districtId)/playerKeys/$(key);
      }

      // 'division-10' for a player's data
      function jerseyIdOf(data) {
        return data.category + '-' + string(data.jerseyNo);
      }

      // ---------- Roles ----------

      // True if the signed-in person is the team admin of this team
      function isTeamAdminOf(teamId) {
        return isSignedIn()
          && exists(userDoc(request.auth.uid))
          && get(userDoc(request.auth.uid)).data.get('role', '') == 'teamAdmin'
          && get(userDoc(request.auth.uid)).data.get('teamId', '') == teamId;
      }

            function teamDoc(teamId) {
        return /databases/$(database)/documents/districts/$(districtId)/teams/$(teamId);
      }

      // Position code → group. Must match position.dart
      function positionGroups() {
        return {
          'GK': 'GK',
          'CB': 'DEF', 'RCB': 'DEF', 'LCB': 'DEF', 'RB': 'DEF', 'LB': 'DEF',
          'RWB': 'DEF', 'LWB': 'DEF', 'RFB': 'DEF', 'LFB': 'DEF',
          'DM': 'MID', 'RDM': 'MID', 'LDM': 'MID', 'CM': 'MID',
          'RM': 'MID', 'LM': 'MID', 'AMF': 'MID',
          'LW': 'FWD', 'RW': 'FWD', 'LWF': 'FWD', 'RWF': 'FWD',
          'CF': 'FWD', 'ST': 'FWD'
        };
      }

      // The fields a team admin may write on a player
      function isValidPlayer(data) {
        return data.keys().hasOnly([
            'teamId', 'teamName', 'category', 'fullName', 'fullNameLower',
            'searchKeys', 'dob', 'position', 'positionGroup', 'jerseyNo',
            'photoUrl', 'thumbUrl', 'status', 'playerCode', 'rejectionReason',
            'createdAt', 'updatedAt', 'approvedAt', 'approvedBy', 'playerKey'
          ])
          && isText(data.fullName, 3, 80)
          && data.fullNameLower == data.fullName.lower()
          && data.searchKeys is list
          && data.searchKeys.size() <= 80
          && data.playerKey is string
          && data.playerKey.size() <= 120
          && data.teamName is string
          && data.category in ['division', 'juvenile']
          && data.dob is timestamp
          && data.dob < request.time
          && data.position in positionGroups()
          && positionGroups()[data.position] == data.positionGroup
          && data.jerseyNo is int
          && data.jerseyNo >= 1
          && data.jerseyNo <= 99
          && isText(data.photoUrl, 10, 2000)
          && isText(data.thumbUrl, 10, 2000)
      }

      // An FA admin of this district (the chairman and the officials he appoints)
      function isFaAdmin() {
        return isSignedIn()
          && exists(userDoc(request.auth.uid))
          && get(userDoc(request.auth.uid)).data.get('role', '') == 'faAdmin';
      }

      // Any team admin (of any team)
      function isTeamAdmin() {
        return isSignedIn()
          && exists(userDoc(request.auth.uid))
          && get(userDoc(request.auth.uid)).data.get('role', '') == 'teamAdmin';
      }

      // The player's reservations exist and point back to this player
      function hasReservations(data, playerId) {
        return getAfter(jerseyDoc(data.teamId, jerseyIdOf(data))).data.playerId == playerId
          && getAfter(playerKeyDoc(data.playerKey)).data.playerId == playerId;
      }

      // ---------- users/{uid} ----------
      match /users/{uid} {
        allow get: if isOwner(uid) || isFaAdmin();

        // FA approves a team: the club's account becomes its team admin.
        // Only 'teamAdmin' can be given here (never 'faAdmin'), only to an
        // admin listed on the team created in the same batch, and only to
        // someone with no role yet (create, not update).
        allow create: if isFaAdmin()
          && request.resource.data.keys().hasOnly(['role', 'teamId', 'createdAt', 'createdBy'])
          && request.resource.data.role == 'teamAdmin'
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && getAfter(teamDoc(request.resource.data.teamId)).data.adminUids.hasAny([uid]);
      }

      // ---------- teamRequests/{uid} ----------
      function isValidTeamRequest(data, uid) {
        return data.keys().hasOnly([
            'teamName', 'teamNameLower', 'nameKey', 'shortName', 'town',
            'homeGround', 'categories', 'homeGroundDirections', 'yearFounded', 'email',
            'logoUrl', 'kits', 'officials', 'agreedToRules', 'status',
            'rejectionReason', 'createdAt', 'updatedAt',
            'reviewedAt', 'reviewedBy', 'teamId'
          ])
          && isText(data.teamName, 2, 60)
          && data.teamNameLower == data.teamName.lower()
          && data.nameKey is string
          && data.nameKey.matches('^[a-z0-9-]{2,60}$')
          && data.shortName is string
          && data.shortName.matches('^[A-Z]{3,4}$')
          && isText(data.town, 2, 60)
          && isText(data.homeGround, 2, 80)
          && isOptionalText(data, 'homeGroundDirections', 300)
          && isOptionalText(data, 'email', 120)
          && isOptionalText(data, 'logoUrl', 2000)
          && data.categories is list
          && data.categories.size() >= 1
          && data.categories.size() <= 2
          && data.categories.hasOnly(['division', 'juvenile'])
          && data.categories.toSet().size() == data.categories.size()
          && (!('yearFounded' in data) || data.yearFounded == null
              || (data.yearFounded is int
                  && data.yearFounded >= 1900 && data.yearFounded <= 2100))
          && data.kits is map
          && data.kits.keys().hasAll(['home', 'away', 'goalkeeper'])
          && data.kits.keys().hasOnly(['home', 'away', 'third', 'goalkeeper', 'goalkeeper2'])
          && data.officials is list
          && data.officials.size() >= 2
          && data.officials.size() <= 10
          && data.agreedToRules == true
          && data.status == 'pending'
          && (!('rejectionReason' in data) || data.rejectionReason == null)
          && data.updatedAt == request.time
          && getAfter(teamNameDoc(data.nameKey)).data.uid == uid;
      }

      // FA approves: only the review fields change. In the same batch the
      // team is created and the club's account becomes its team admin.
      function isApproval(uid) {
        let after = request.resource.data;
        return after.status == 'approved'
          && after.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'teamId', 'reviewedAt', 'reviewedBy', 'updatedAt'])
          && after.teamId == resource.data.nameKey
          && getAfter(teamDoc(after.teamId)).data.requestUid == uid
          && getAfter(userDoc(uid)).data.role == 'teamAdmin'
          && getAfter(userDoc(uid)).data.teamId == after.teamId;
      }

      // FA rejects: status and a real reason (10 to 500 characters).
      function isRejection() {
        let after = request.resource.data;
        return after.status == 'rejected'
          && after.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'rejectionReason', 'reviewedAt', 'reviewedBy', 'updatedAt'])
          && isText(after.rejectionReason, 10, 500);
      }

      match /teamRequests/{uid} {
        allow get: if isOwner(uid) || isFaAdmin();
        allow list: if isFaAdmin();

        allow create: if isOwner(uid)
          && hasConfirmedEmail()
          && isValidTeamRequest(request.resource.data, uid)
          && !request.resource.data.keys().hasAny(['reviewedAt', 'reviewedBy', 'teamId'])
          && request.resource.data.createdAt == request.time;

        // The club edits its own request (pending or rejected).
        // It can never touch the FA's review fields.
        allow update: if isOwner(uid)
          && hasConfirmedEmail()
          && resource.data.status in ['pending', 'rejected']
          && isValidTeamRequest(request.resource.data, uid)
          && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['reviewedAt', 'reviewedBy', 'teamId'])
          && request.resource.data.createdAt == resource.data.createdAt;

        // The FA approves or rejects a pending request.
        allow update: if isFaAdmin()
          && resource.data.status == 'pending'
          && request.resource.data.reviewedBy == request.auth.uid
          && request.resource.data.reviewedAt == request.time
          && request.resource.data.updatedAt == request.time
          && (isApproval(uid) || isRejection());
      }

      // ---------- teamNames/{nameKey} ----------
      match /teamNames/{nameKey} {
        allow get: if isSignedIn();

        allow create: if isOwner(request.resource.data.uid)
          && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
          && request.resource.data.createdAt == request.time
          && getAfter(teamRequestDoc(request.auth.uid)).data.nameKey == nameKey;

        allow delete: if isOwner(resource.data.uid)
          && (!existsAfter(teamRequestDoc(request.auth.uid))
              || getAfter(teamRequestDoc(request.auth.uid)).data.nameKey != nameKey);
      }

            // ---------- teams/{teamId} ----------
      match /teams/{teamId} {
        allow get: if isTeamAdminOf(teamId) || isFaAdmin();
        allow list: if isFaAdmin();

        // FA approves a request: the team is created from it, in the same
        // batch as the approval. Its ID is the reserved team-name key.
        allow create: if isFaAdmin()
          && request.resource.data.requestUid is string
          && request.resource.data.nameKey == teamId
          && request.resource.data.adminUids == [request.resource.data.requestUid]
          && get(teamNameDoc(teamId)).data.uid == request.resource.data.requestUid
          && getAfter(teamRequestDoc(request.resource.data.requestUid)).data.status == 'approved'
          && getAfter(teamRequestDoc(request.resource.data.requestUid)).data.teamId == teamId
          && request.resource.data.createdAt == request.time;

        // ---------- teams/{teamId}/jerseys/{jerseyId} ----------
        match /jerseys/{jerseyId} {
          allow get: if isTeamAdminOf(teamId);

          allow create: if isTeamAdminOf(teamId)
            && request.resource.data.keys().hasOnly(['playerId', 'createdAt'])
            && request.resource.data.createdAt == request.time
            && getAfter(playerDoc(request.resource.data.playerId)).data.teamId == teamId
            && jerseyIdOf(getAfter(playerDoc(request.resource.data.playerId)).data) == jerseyId;

          allow delete: if isTeamAdminOf(teamId)
            && (!existsAfter(playerDoc(resource.data.playerId))
                || jerseyIdOf(getAfter(playerDoc(resource.data.playerId)).data) != jerseyId);
        }
      }

      // ---------- playerKeys/{key} ----------
      match /playerKeys/{key} {
        allow get: if isTeamAdmin();

        allow create: if isTeamAdminOf(request.resource.data.teamId)
          && request.resource.data.keys().hasOnly(['playerId', 'teamId', 'createdAt'])
          && request.resource.data.createdAt == request.time
          && getAfter(playerDoc(request.resource.data.playerId)).data.playerKey == key
          && getAfter(playerDoc(request.resource.data.playerId)).data.teamId
               == request.resource.data.teamId;

        allow delete: if isTeamAdminOf(resource.data.teamId)
          && (!existsAfter(playerDoc(resource.data.playerId))
              || getAfter(playerDoc(resource.data.playerId)).data.playerKey != key);
      }

            // ---------- players/{playerId} ----------
      match /players/{playerId} {
        allow read: if isTeamAdminOf(resource.data.teamId);
      

        allow create: if isTeamAdminOf(request.resource.data.teamId)
          && isValidPlayer(request.resource.data)
          && hasReservations(request.resource.data, playerId)
          && request.resource.data.category == 'division'
          && get(teamDoc(request.resource.data.teamId)).data.categories
               .hasAny([request.resource.data.category])
          && request.resource.data.status == 'pending'
          && !('playerCode' in request.resource.data)
          && !('approvedAt' in request.resource.data)
          && !('approvedBy' in request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if isTeamAdminOf(resource.data.teamId)
          && isValidPlayer(request.resource.data)
          && hasReservations(request.resource.data, playerId)
          && request.resource.data.teamId == resource.data.teamId
          && request.resource.data.category == resource.data.category
          && request.resource.data.get('playerCode', null) == resource.data.get('playerCode', null)
          && request.resource.data.get('approvedAt', null) == resource.data.get('approvedAt', null)
          && request.resource.data.get('approvedBy', null) == resource.data.get('approvedBy', null)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && (request.resource.data.status == 'pending'
              || (resource.data.status == 'approved'
                  && request.resource.data.status == 'approved'
                  && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['position', 'positionGroup', 'updatedAt'])));
      }
    } // end of districts/{districtId}

    // ---------- Everything else ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}