rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasConfirmedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function isOptionalText(data, field, max) {
      return !(field in data)
        || data[field] == null
        || (data[field] is string && data[field].size() <= max);
    }

    match /districts/{districtId} {

      // ---------- Paths ----------

      function teamNameDoc(key) {
        return /databases/$(database)/documents/districts/$(districtId)/teamNames/$(key);
      }

      function teamRequestDoc(uid) {
        return /databases/$(database)/documents/districts/$(districtId)/teamRequests/$(uid);
      }

      function userDoc(uid) {
        return /databases/$(database)/documents/districts/$(districtId)/users/$(uid);
      }

      function playerDoc(playerId) {
        return /databases/$(database)/documents/districts/$(districtId)/players/$(playerId);
      }

      function jerseyDoc(teamId, jerseyId) {
        return /databases/$(database)/documents/districts/$(districtId)/teams/$(teamId)/jerseys/$(jerseyId);
      }

      function playerKeyDoc(key) {
        return /databases/$(database)/documents/districts/$(districtId)/playerKeys/$(key);
      }

      // 'division-10', or 'juvenile-U13-10' for a juvenile player (2.14).
      // Must match jerseyIdFor in player_key.dart.
      function jerseyIdOf(data) {
        return data.category == 'juvenile'
          ? 'juvenile-' + data.get('ageGroup', '') + '-' + string(data.jerseyNo)
          : data.category + '-' + string(data.jerseyNo);
      }

      // ---------- Roles ----------

      // True if the signed-in person is the team admin of this team
      function isTeamAdminOf(teamId) {
        return isSignedIn()
          && exists(userDoc(request.auth.uid))
          && get(userDoc(request.auth.uid)).data.get('role', '') == 'teamAdmin'
          && get(userDoc(request.auth.uid)).data.get('teamId', '') == teamId;
      }

      function teamDoc(teamId) {
        return /databases/$(database)/documents/districts/$(districtId)/teams/$(teamId);
      }

      // A team's request to the FA (2.10b): one per team and kind,
      // e.g. teamChanges/royal_name
      function teamChangeDoc(teamId, kind) {
        let changeId = teamId + '_' + kind;
        return /databases/$(database)/documents/districts/$(districtId)/teamChanges/$(changeId);
      }

      // Juvenile side names: a club in both competitions plays its juvenile
      // matches under its own juvenile name, or its name with " B"
      // ("Royal Unique FC B", "RUF B"). Everyone else plays as the club.
      // The app does the same (side_name.dart).
      // [name, shortName] in one go: a match save is close to the rules'
      // limit of 1000 expressions, so this is worked out once per side.
      function sideNamesOf(team, category) {
        return category == 'juvenile' && team.get('categories', []).size() == 2
          ? [team.get('juvenileName', team.name + ' B'),
             team.get('juvenileShortName', team.get('shortName', '') + ' B')]
          : [team.name, team.get('shortName', '')];
      }

      // One line of a team's corrections log (2.11a)
      function correctionDoc(teamId, correctionId) {
        return /databases/$(database)/documents/districts/$(districtId)/teams/$(teamId)/corrections/$(correctionId);
      }

      // The log line the team points at after this write, written in this
      // same batch (its createdAt is now). 2.11a
      function newCorrectionOf(teamId) {
        let after = getAfter(teamDoc(teamId)).data;
        let log = getAfter(correctionDoc(teamId, after.get('lastCorrectionId', '-'))).data;
        return log.createdAt == request.time ? log : null;
      }

      // ---------- Suspensions (2.11c) ----------

      // One suspension in a team's history: teams/{teamId}/suspensions/{id}
      function suspensionDoc(teamId, suspensionId) {
        return /databases/$(database)/documents/districts/$(districtId)/teams/$(teamId)/suspensions/$(suspensionId);
      }

      // A team's `suspension` map is in force: no end date (until the
      // chairman lifts it), or the end date hasn't come yet
      function isActiveSuspension(suspension) {
        return suspension != null
          && (suspension.get('until', null) == null || request.time < suspension.until);
      }

      // The team is suspended now: it can't add or edit players, edit its
      // profile or ask for changes. It still reads everything and pays.
      function isSuspended(teamId) {
        return isActiveSuspension(get(teamDoc(teamId)).data.get('suspension', null));
      }

      // This batch corrects the spelling of the team's name to [nameKey]'s
      // name (2.11a)
      function isCorrectingNameTo(teamId, nameKey) {
        let log = newCorrectionOf(teamId);
        return log != null && 'name' in log.fields && log.nameKey == nameKey;
      }

      // Position code → group. Must match position.dart
      function positionGroups() {
        return {
          'GK': 'GK',
          'CB': 'DEF', 'RCB': 'DEF', 'LCB': 'DEF', 'RB': 'DEF', 'LB': 'DEF',
          'RWB': 'DEF', 'LWB': 'DEF', 'RFB': 'DEF', 'LFB': 'DEF',
          'DM': 'MID', 'RDM': 'MID', 'LDM': 'MID', 'CM': 'MID',
          'RM': 'MID', 'LM': 'MID', 'AMF': 'MID',
          'LW': 'FWD', 'RW': 'FWD', 'LWF': 'FWD', 'RWF': 'FWD',
          'CF': 'FWD', 'ST': 'FWD'
        };
      }

      // settings/league (2.13d): read by several rules below
      function leagueDoc() {
        return /databases/$(database)/documents/districts/$(districtId)/settings/league;
      }

      // A league setting, or [fallback] before the FA has saved it
      function leagueValue(field, fallback) {
        return exists(leagueDoc()) ? get(leagueDoc()).data.get(field, fallback) : fallback;
      }

      // Juvenile players (2.14): an age group the child may play in, and a
      // parent or guardian. Age = the season's start year - birth year;
      // own group or older (playing up), never younger, never over 17.
      // Division players have neither.
      function isValidAgeGroup(data) {
        let maxAge = {'U13': 13, 'U15': 15, 'U17': 17};
        let startYear = int(leagueValue('season', '2026-27').split('-')[0]);
        return (data.category == 'division'
            && !('ageGroup' in data) && !('guardian' in data))
          || (data.category == 'juvenile'
            && data.get('ageGroup', '') in maxAge
            && startYear - data.dob.year() <= maxAge[data.ageGroup]
            && data.get('guardian', null) is map
            && data.guardian.keys().hasOnly(['relation', 'name', 'phone'])
            && data.guardian.get('relation', '') in ['mother', 'father', 'guardian', 'other']
            && isText(data.guardian.get('name', null), 3, 80)
            && isText(data.guardian.get('phone', null), 9, 20));
      }

      // The fields a team admin may write on a player
      function isValidPlayer(data) {
        return data.keys().hasOnly([
            'teamId', 'teamName', 'category', 'fullName', 'fullNameLower',
            'searchKeys', 'dob', 'position', 'positionGroup', 'jerseyNo',
            'photoUrl', 'thumbUrl', 'status', 'playerCode', 'rejectionReason',
            'createdAt', 'updatedAt', 'approvedAt', 'approvedBy', 'playerKey',
            'reviewedAt', 'reviewedBy', 'changes', 'ageGroup', 'guardian',
            'notEligible', 'screeningDayId'
          ])
          && isValidAgeGroup(data)
          // What the team changed since the FA last saw the player (2.3c),
          // e.g. {jerseyNo: {from: '#10', to: '#14'}}. Shown to the FA.
          && (!('changes' in data) || (data.changes is map && data.changes.size() <= 8))
          && isText(data.fullName, 3, 80)
          && data.fullNameLower == data.fullName.lower()
          && data.searchKeys is list
          && data.searchKeys.size() <= 80
          && data.playerKey is string
          && data.playerKey.size() <= 120
          && data.teamName is string
          && data.category in ['division', 'juvenile']
          && data.dob is timestamp
          && data.dob < request.time
          && data.position in positionGroups()
          && positionGroups()[data.position] == data.positionGroup
          && data.jerseyNo is int
          && data.jerseyNo >= 1
          && data.jerseyNo <= 99
          && isText(data.photoUrl, 10, 2000)
          && isText(data.thumbUrl, 10, 2000)
      }

      // An FA admin of this district (the chairman and the officials he appoints)
      function isFaAdmin() {
        return isSignedIn()
          && exists(userDoc(request.auth.uid))
          && get(userDoc(request.auth.uid)).data.get('role', '') == 'faAdmin';
      }

      // Any team admin (of any team)
      function isTeamAdmin() {
        return isSignedIn()
          && exists(userDoc(request.auth.uid))
          && get(userDoc(request.auth.uid)).data.get('role', '') == 'teamAdmin';
      }

      // The player's reservations exist and point back to this player
      function hasReservations(data, playerId) {
        return getAfter(jerseyDoc(data.teamId, jerseyIdOf(data))).data.playerId == playerId
          && getAfter(playerKeyDoc(data.playerKey)).data.playerId == playerId;
      }

      // ---------- Invitations (2.6) ----------

      function inviteDoc(inviteId) {
        return /databases/$(database)/documents/districts/$(districtId)/invites/$(inviteId);
      }

      // The chairman: an FA admin with isChairman: true (set by hand once)
      function isChairman() {
        return isFaAdmin()
          && get(userDoc(request.auth.uid)).data.get('isChairman', false) == true;
      }

      // My confirmed email in lower case = the ID of my invitation
      function myEmail() {
        return request.auth.token.email.lower();
      }

      // An invitation I may still accept: for my confirmed email,
      // pending and not expired
      function isMyOpenInvite(inviteId) {
        return hasConfirmedEmail()
          && request.auth.token.email is string
          && inviteId == myEmail()
          && exists(inviteDoc(inviteId))
          && get(inviteDoc(inviteId)).data.status == 'pending'
          && get(inviteDoc(inviteId)).data.expiresAt > request.time;
      }

      // ---------- users/{uid} ----------
      match /users/{uid} {
        allow get: if isOwner(uid) || isFaAdmin();

        // People and roles: the FA lists FA admins and referees
        allow list: if isFaAdmin();

        // Accepting an invitation: I create my own user document with the
        // role from my invitation, in the same batch that marks the
        // invitation accepted. One role per account (create, not update).
        allow create: if isOwner(uid)
          && isMyOpenInvite(request.resource.data.inviteId)
          && request.resource.data.keys().hasOnly(['role', 'name', 'email', 'inviteId', 'createdAt'])
          && request.resource.data.role == get(inviteDoc(request.resource.data.inviteId)).data.role
          && request.resource.data.email == myEmail()
          && isText(request.resource.data.name, 1, 80)
          && request.resource.data.createdAt == request.time
          && getAfter(inviteDoc(request.resource.data.inviteId)).data.status == 'accepted'
          && getAfter(inviteDoc(request.resource.data.inviteId)).data.acceptedBy == uid;

        // Removing a role: the chairman removes FA officials, any FA admin
        // removes referees. Nobody removes themselves, and the chairman's
        // role can't be removed in the app (so there is always an FA admin).
        allow delete: if isFaAdmin()
          && uid != request.auth.uid
          && resource.data.get('isChairman', false) != true
          && (resource.data.role == 'referee'
              || (resource.data.role == 'faAdmin' && isChairman()));

        // FA approves a team: the club's account becomes its team admin.
        // Only 'teamAdmin' can be given here (never 'faAdmin'), only to an
        // admin listed on the team created in the same batch, and only to
        // someone with no role yet (create, not update).
        allow create: if isFaAdmin()
          && request.resource.data.keys().hasOnly(['role', 'teamId', 'createdAt', 'createdBy'])
          && request.resource.data.role == 'teamAdmin'
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && getAfter(teamDoc(request.resource.data.teamId)).data.adminUids.hasAny([uid]);
      }

      // ---------- invites/{email} ----------
      // The document ID is the invited email in lower case, so the invited
      // person can find their invitation with one get, and an email has at
      // most one invitation at a time.
      match /invites/{inviteId} {
        allow get: if isFaAdmin()
          || (hasConfirmedEmail()
              && request.auth.token.email is string
              && inviteId == myEmail());
        allow list: if isFaAdmin();

        // Create: FA officials invite referees; only the chairman invites
        // FA officials. Expires in 14 days (a day either way for clocks).
        allow create: if isFaAdmin()
          && request.resource.data.keys().hasOnly([
               'email', 'name', 'role', 'status', 'invitedBy', 'invitedByName',
               'createdAt', 'expiresAt'
             ])
          && request.resource.data.email == inviteId
          && inviteId.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
          && isText(request.resource.data.name, 3, 80)
          && (request.resource.data.role == 'referee'
              || (request.resource.data.role == 'faAdmin' && isChairman()))
          && request.resource.data.status == 'pending'
          && request.resource.data.invitedBy == request.auth.uid
          && isText(request.resource.data.invitedByName, 1, 80)
          && request.resource.data.createdAt == request.time
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt > request.time + duration.value(13, 'd')
          && request.resource.data.expiresAt < request.time + duration.value(15, 'd');

        // Accept: only the invited person, while it is open, and only
        // together with creating their user document with that role.
        allow update: if isMyOpenInvite(inviteId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'acceptedBy', 'acceptedAt'])
          && request.resource.data.status == 'accepted'
          && request.resource.data.acceptedBy == request.auth.uid
          && request.resource.data.acceptedAt == request.time
          && getAfter(userDoc(request.auth.uid)).data.role == resource.data.role;

        // Cancel (FA, same who-can-invite rule), decline (the invited person),
        // or clear an accepted one when the role is removed (FA).
        allow delete: if (isFaAdmin()
              && (resource.data.role == 'referee' || isChairman()))
          || (hasConfirmedEmail()
              && request.auth.token.email is string
              && inviteId == myEmail()
              && resource.data.status == 'pending');
      }

      // ---------- roleLog/{entryId} ----------
      // Role history. Written in the same batch as each change; never
      // edited or deleted.
      match /roleLog/{entryId} {
        allow list, get: if isFaAdmin();
        allow create: if request.resource.data.keys().hasOnly([
               'email', 'name', 'role', 'action', 'uid', 'by', 'byName', 'at'
             ])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.at == request.time
          && request.resource.data.role in ['faAdmin', 'referee']
          && isText(request.resource.data.email, 3, 120)
          && isText(request.resource.data.byName, 1, 80)
          && ((isFaAdmin()
                && request.resource.data.action in ['invited', 'cancelled', 'removed'])
              || (hasConfirmedEmail()
                && request.auth.token.email is string
                && request.resource.data.email == myEmail()
                && request.resource.data.action in ['accepted', 'declined']));
      }

      // ---------- Announcements and notifications (2.7 – 2.8) ----------

      function myRole() {
        return get(userDoc(request.auth.uid)).data.get('role', '');
      }

      function hasRole() {
        return isSignedIn()
          && exists(userDoc(request.auth.uid))
          && myRole() in ['faAdmin', 'teamAdmin', 'referee'];
      }

      // announcements/{id}: written by any FA admin, read by everyone with
      // a role (the app shows each person only the ones meant for them).
      match /announcements/{announcementId} {
        allow get, list: if hasRole();

        allow create: if isFaAdmin()
          && request.resource.data.keys().hasOnly([
               'title', 'body', 'to', 'important', 'pinned',
               'createdBy', 'createdByName', 'createdAt'
             ])
          && isText(request.resource.data.title, 3, 80)
          && isText(request.resource.data.body, 10, 2000)
          && request.resource.data.to in ['everyone', 'teams', 'division', 'juvenile', 'referees']
          && request.resource.data.important is bool
          && request.resource.data.pinned is bool
          && request.resource.data.createdBy == request.auth.uid
          && isText(request.resource.data.createdByName, 1, 80)
          && request.resource.data.createdAt == request.time;

        // Pin or unpin only; the text never changes once sent
        allow update: if isFaAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned'])
          && request.resource.data.pinned is bool;

        allow delete: if isFaAdmin();

        // seen/{teamId or uid}: "Seen by 7 of 12" (FA only reads it)
        match /seen/{key} {
          allow get, list: if isFaAdmin();
          allow create, update: if hasRole()
            && (key == request.auth.uid || isTeamAdminOf(key))
            && request.resource.data.keys().hasOnly(['at', 'by'])
            && request.resource.data.by == request.auth.uid
            && request.resource.data.at == request.time;
        }
      }

      // ---------- Juvenile screening days (2.14b) ----------

      function announcementDoc(id) {
        return /databases/$(database)/documents/districts/$(districtId)/announcements/$(id);
      }

      // screeningDays/{id}: written by the FA in ONE batch with its
      // announcement to Juvenile teams (announcementId points to it).
      function isValidScreeningDay(data) {
        return data.keys().hasOnly([
            'startsAt', 'venue', 'groups', 'note', 'announcementId', 'season',
            'createdBy', 'createdAt'
          ])
          && data.keys().hasAll([
            'startsAt', 'venue', 'groups', 'announcementId', 'season',
            'createdBy', 'createdAt'
          ])
          && data.startsAt is timestamp
          && data.startsAt > request.time
          && isText(data.venue, 2, 80)
          && data.groups is list
          && data.groups.size() >= 1 && data.groups.size() <= 3
          && data.groups.hasOnly(['U13', 'U15', 'U17'])
          && data.groups.toSet().size() == data.groups.size()
          && isOptionalText(data, 'note', 200)
          && data.announcementId is string
          && existsAfter(announcementDoc(data.announcementId))
          && getAfter(announcementDoc(data.announcementId)).data.to == 'juvenile'
          && isText(data.season, 7, 7)
          && data.createdBy == request.auth.uid
          && data.createdAt == request.time;
      }

      match /screeningDays/{dayId} {
        // Teams see the blue card; the FA plans the day
        allow get, list: if hasRole();
        allow create: if isFaAdmin() && isValidScreeningDay(request.resource.data);
        // Cancelling removes it; a day is never edited (cancel and add again)
        allow delete: if isFaAdmin();
      }

      // notifications/{id}: one per audience, kind, team and day; each new
      // event updates it (count + 1, one more name), so 20 approvals make
      // 1 notification. audience = 'fa' or 'team:<teamId>'.
      function isValidNotification(data) {
        return data.keys().hasOnly([
            'audience', 'kind', 'teamId', 'teamName', 'names', 'count', 'day',
            'updatedAt'
          ])
          && data.audience is string
          && data.kind in ['playersApproved', 'playersRejected', 'teamApproved',
                           'teamRequest', 'playersSubmitted', 'playersResubmitted',
                           'juvenileSubmitted', 'inviteAccepted', 'paymentConfirmed', 'paymentNotFound',
                           'feeReminder', 'paymentSent', 'registrationChanged',
                           'juvenilePassed', 'juvenileNotEligible', 'juvenileToCorrect',
                           'teamUpdated', 'changeRequested', 'changeApproved',
                           'changeRefused', 'teamCorrected', 'correctionAsked',
                           'correctionSentBack', 'correctionDone',
                           'teamSuspended', 'suspensionLifted',
                           'fixtureAdded', 'fixtureChanged', 'fixturePostponed',
                           'fixtureCancelled']
          && data.teamId is string
          && data.teamName is string
          && data.names is list && data.names.size() <= 60
          && data.count is int && data.count >= 1
          && data.day is string && data.day.size() == 10
          && data.updatedAt == request.time;
      }

      // Who may write a notification for the FA's bell
      function canNotifyFa(data) {
        return hasConfirmedEmail()
          && (isFaAdmin()
              || (data.kind in ['playersSubmitted', 'playersResubmitted',
                                'juvenileSubmitted', 'paymentSent', 'teamUpdated',
                                'changeRequested', 'correctionSentBack']
                  && isTeamAdminOf(data.teamId))
              || data.kind in ['teamRequest', 'inviteAccepted']);
      }

      match /notifications/{notificationId} {
        allow get, list: if (resource.data.audience == 'fa' && isFaAdmin())
          || (isTeamAdmin()
              && resource.data.audience
                   == 'team:' + get(userDoc(request.auth.uid)).data.get('teamId', ''));

        allow create, update: if isValidNotification(request.resource.data)
          && ((request.resource.data.audience == 'fa'
                && canNotifyFa(request.resource.data))
              || (request.resource.data.audience == 'team:' + request.resource.data.teamId
                && isFaAdmin()));
      }

      // readMarks/{uid}: when I last pressed "Mark all read", the notes I
      // read one by one (reads: note ID → its time when read, 3.0f; at most
      // 100, the bell shows 60 notes and 40 announcements), and the pinned
      // announcements I hid. Mine only.
      match /readMarks/{uid} {
        allow get: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['notificationsSeenAt', 'reads', 'hiddenAnnouncements'])
          && request.resource.data.get('reads', {}) is map
          && request.resource.data.get('reads', {}).size() <= 100
          && (request.resource.data.get('notificationsSeenAt', null) == null
              || request.resource.data.notificationsSeenAt is timestamp)
          && request.resource.data.get('hiddenAnnouncements', []) is list
          && request.resource.data.get('hiddenAnnouncements', []).size() <= 30;
      }

      // ---------- settings/league (2.13d) ----------

      // '2026-27'
      function isSeason(value) {
        return value is string && value.matches('^20[0-9]{2}-[0-9]{2}$');
      }

      function isOptionalInt(data, field, min, max) {
        return !(field in data)
          || (data[field] is int && data[field] >= min && data[field] <= max);
      }

      function isOptionalBool(data, field) {
        return !(field in data) || data[field] is bool;
      }

      function isValidLeagueSettings(data) {
        return data.keys().hasOnly([
            'teamRegistrationOpen', 'playerRegistrationOpen',
            'maxSquadSize', 'matchdaySquad', 'matchdaySubs', 'minPlayers',
            'season', 'fee', 'momoNumber', 'updatedBy', 'updatedAt'
          ])
          && isOptionalBool(data, 'teamRegistrationOpen')
          && isOptionalBool(data, 'playerRegistrationOpen')
          && isOptionalInt(data, 'maxSquadSize', 11, 40)
          && isOptionalInt(data, 'matchdaySquad', 11, 23)
          && isOptionalInt(data, 'matchdaySubs', 0, 12)
          && isOptionalInt(data, 'minPlayers', 7, 11)
          && (!('season' in data) || isSeason(data.season))
          && isOptionalInt(data, 'fee', 1, 100000)
          && (!('momoNumber' in data) || isText(data.momoNumber, 4, 20))
          && data.updatedBy == request.auth.uid
          && data.updatedAt == request.time;
      }

      // Season, fee and MoMo number: the chairman only
      function touchesChairmanFields() {
        let fields = ['season', 'fee', 'momoNumber'];
        return resource == null
          ? request.resource.data.keys().hasAny(fields)
          : request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
      }

      match /settings/league {
        allow get: if isSignedIn();
        allow create, update: if isFaAdmin()
          && isValidLeagueSettings(request.resource.data)
          && (!touchesChairmanFields() || isChairman());
      }

      // settingsLog/{id}: who changed which setting and when. FA only;
      // never changed or deleted.
      match /settingsLog/{id} {
        allow get, list: if isFaAdmin();
        allow create: if isFaAdmin()
          && request.resource.data.keys().hasOnly(['by', 'byName', 'at', 'changes'])
          && request.resource.data.by == request.auth.uid
          && isText(request.resource.data.byName, 1, 120)
          && request.resource.data.at == request.time
          && request.resource.data.changes is map;
      }

      // ---------- Season fee: payments, fees, receipts (2.13c) ----------

      // Whole cedis, 1 to the fee (GH₵ 1,000). Must match season.dart.
      function isFeeAmount(value) {
        return value is int && value >= 1 && value <= leagueValue('fee', 1000);
      }


      // One club's confirmed total for a season: fees/2026-27_<uid>
      function feeDoc(season, uid) {
        return /databases/$(database)/documents/districts/$(districtId)/fees/$(season + '_' + uid);
      }

      function confirmedSoFar(season, uid) {
        return exists(feeDoc(season, uid)) ? get(feeDoc(season, uid)).data.confirmed : 0;
      }

      function isFeeStarted(season, uid) {
        return confirmedSoFar(season, uid) > 0;
      }

      // The FA's confirmation adds exactly this payment to the club's total
      function addsToTotal(season, uid, amount) {
        return getAfter(feeDoc(season, uid)).data.confirmed
          == confirmedSoFar(season, uid) + amount;
      }

      function receiptCounterDoc() {
        return /databases/$(database)/documents/districts/$(districtId)/settings/receiptCounter;
      }

      // The number the next receipt gets (1 if no counter yet)
      function nextReceipt() {
        return exists(receiptCounterDoc()) ? get(receiptCounterDoc()).data.next : 1;
      }

      // 14 in season 2026-27 -> 'GEDFA-2026-0014'. Must match payment.dart.
      function receiptNoFor(n, season) {
        return 'GEDFA-' + season.split('-')[0] + '-'
          + (n < 10 ? '000' : (n < 100 ? '00' : (n < 1000 ? '0' : '')))
          + string(n);
      }

      // A receipt takes the counter's number; the counter moves on by 1
      function takesNextReceipt(receiptNo, season) {
        return receiptNo == receiptNoFor(nextReceipt(), season)
          && getAfter(receiptCounterDoc()).data.next == nextReceipt() + 1;
      }

      // What a club sends: waiting for the FA. MoMo needs the transaction
      // ID, the amount and the date; cash the amount; "already paid"
      // neither (the FA fills in the amount from its records).
      function isValidClubPayment(data) {
        return data.keys().hasOnly([
            'requestUid', 'teamId', 'teamName', 'season', 'method', 'amount',
            'reference', 'paidOn', 'paidWhen', 'paidTo', 'proofUrl',
            'status', 'recordedBy', 'createdBy', 'createdAt'
          ])
          && data.requestUid == request.auth.uid
          && data.createdBy == request.auth.uid
          && isText(data.teamName, 2, 60)
          && isSeason(data.season)
          && data.status == 'waiting'
          && data.recordedBy == 'club'
          && data.createdAt == request.time
          && isOptionalText(data, 'paidWhen', 40)
          && isOptionalText(data, 'paidTo', 60)
          && isOptionalText(data, 'proofUrl', 2000)
          && ((data.method == 'momo'
                 && isFeeAmount(data.get('amount', null))
                 && isText(data.get('reference', null), 4, 30)
                 && data.get('paidOn', null) is timestamp)
              || (data.method == 'cash'
                 && isFeeAmount(data.get('amount', null))
                 && data.get('reference', null) == null)
              || (data.method == 'before'
                 && data.get('amount', null) == null
                 && data.get('reference', null) == null));
      }

      // Cash the FA received in person: confirmed straight away.
      function isFaCash(data) {
        return data.keys().hasOnly([
            'requestUid', 'teamId', 'teamName', 'season', 'method', 'amount',
            'paidWhen', 'status', 'receiptNo', 'recordedBy',
            'createdBy', 'createdAt', 'reviewedBy', 'reviewedAt'
          ])
          && data.requestUid is string
          && isText(data.teamName, 2, 60)
          && isSeason(data.season)
          && data.method == 'cash'
          && isFeeAmount(data.amount)
          && isOptionalText(data, 'paidWhen', 40)
          && data.status == 'confirmed'
          && data.recordedBy == 'fa'
          && data.createdBy == request.auth.uid
          && data.reviewedBy == request.auth.uid
          && data.createdAt == request.time
          && data.reviewedAt == request.time
          && takesNextReceipt(data.receiptNo, data.season)
          && addsToTotal(data.season, data.requestUid, data.amount);
      }

      // The FA confirms a waiting payment: receipt, amount (kept, or filled
      // in for "already paid"), and the club's total goes up by it.
      function isPaymentConfirmation() {
        let before = resource.data;
        let after = request.resource.data;
        return after.status == 'confirmed'
          && after.diff(before).affectedKeys()
               .hasOnly(['status', 'amount', 'receiptNo', 'reviewedBy', 'reviewedAt'])
          && after.reviewedBy == request.auth.uid
          && after.reviewedAt == request.time
          && isFeeAmount(after.amount)
          && (before.get('amount', null) == null || after.amount == before.amount)
          && takesNextReceipt(after.receiptNo, before.season)
          && addsToTotal(before.season, before.requestUid, after.amount);
      }

      // Payments are never rejected. "Not found" is only for an ID that
      // isn't on the FA's statement, or details that are false.
      function isPaymentNotFound() {
        let after = request.resource.data;
        return after.status == 'notFound'
          && after.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'reason', 'reviewedBy', 'reviewedAt'])
          && isText(after.reason, 5, 300)
          && after.reviewedBy == request.auth.uid
          && after.reviewedAt == request.time;
      }

      // The FA fixes the amount of cash it recorded itself (a typing
      // mistake). The receipt stays; the club's total changes by the
      // difference.
      function isCashCorrection() {
        let before = resource.data;
        let after = request.resource.data;
        return before.status == 'confirmed'
          && before.recordedBy == 'fa'
          && after.diff(before).affectedKeys()
               .hasOnly(['amount', 'editedBy', 'editedAt'])
          && isFeeAmount(after.amount)
          && after.editedBy == request.auth.uid
          && after.editedAt == request.time
          && getAfter(feeDoc(before.season, before.requestUid)).data.confirmed
               == confirmedSoFar(before.season, before.requestUid)
                  - before.amount + after.amount;
      }

      match /payments/{paymentId} {
        allow get: if isFaAdmin()
          || isOwner(resource.data.requestUid)
          || (resource.data.get('teamId', null) != null
              && isTeamAdminOf(resource.data.teamId));
        allow list: if isFaAdmin() || resource.data.requestUid == request.auth.uid;

        // The club sends a payment: with its registration (same batch),
        // or later from its team.
        allow create: if hasConfirmedEmail()
          && isValidClubPayment(request.resource.data)
          && existsAfter(teamRequestDoc(request.auth.uid))
          && (request.resource.data.get('teamId', null) == null
              || isTeamAdminOf(request.resource.data.teamId));

        allow create: if isFaAdmin() && isFaCash(request.resource.data);

        allow update: if isFaAdmin()
          && ((resource.data.status == 'waiting'
                && (isPaymentConfirmation() || isPaymentNotFound()))
              || isCashCorrection());
      }

      // fees/{season}_{uid}: written only by the FA, in the same
      // transaction as each confirmation (and the approval adds teamId).
      // The club reads its own, even before it exists.
      match /fees/{feeId} {
        allow get: if isFaAdmin() || feeId.split('_')[1] == request.auth.uid;
        allow list: if isFaAdmin();
        allow create, update: if isFaAdmin()
          && request.resource.data.keys()
               .hasOnly(['season', 'requestUid', 'teamName', 'teamId', 'confirmed', 'updatedAt'])
          && isSeason(request.resource.data.season)
          && feeId == request.resource.data.season + '_' + request.resource.data.requestUid
          && request.resource.data.confirmed is int
          && request.resource.data.confirmed >= 0;
      }

      // settings/receiptCounter: the next receipt number. Only moves
      // forward, one at a time, inside the FA's transactions.
      match /settings/receiptCounter {
        allow get: if isFaAdmin();
        allow create: if isFaAdmin()
          && request.resource.data.keys().hasOnly(['next'])
          && request.resource.data.next == 2;
        allow update: if isFaAdmin()
          && request.resource.data.keys().hasOnly(['next'])
          && request.resource.data.next == resource.data.next + 1;
      }

      // ---------- teamRequests/{uid} ----------

      // Home, away and goalkeeper kits, plus an optional third kit and
      // second goalkeeper kit. Each kit is designed or made of photos.
      function isValidKitSet(kits) {
        return kits is map
          && kits.keys().hasAll(['home', 'away', 'goalkeeper'])
          && kits.keys().hasOnly(['home', 'away', 'third', 'goalkeeper', 'goalkeeper2']);
      }

      function isHexColour(value) {
        return value is string && value.matches('^#[0-9A-Fa-f]{6}$');
      }

      // Team colours (2.13b): home and away, a main and a second colour each.
      function isColourPair(pair) {
        return pair is map
          && pair.keys().hasOnly(['main', 'second'])
          && isHexColour(pair.get('main', null))
          && isHexColour(pair.get('second', null));
      }

      function isValidTeamColours(colours) {
        return colours is map
          && colours.keys().hasOnly(['home', 'away'])
          && isColourPair(colours.get('home', null))
          && isColourPair(colours.get('away', null));
      }

      // In the district already: no league, no letter. A new club: the
      // league it played in last season and a letter to the chairman.
      // Either may add a licence (a photo or a PDF). (2.13)
      function isValidClubStatus(data) {
        let isNew = data.get('clubStatus', '') == 'new';
        return data.get('clubStatus', '') in ['existing', 'new']
          && ((isNew
                 && isText(data.get('lastLeague', null), 2, 80)
                 && isText(data.get('letterUrl', null), 10, 2000))
              || (!isNew
                 && data.get('lastLeague', null) == null
                 && data.get('letterUrl', null) == null))
          && isOptionalText(data, 'licenceUrl', 2000)
          && ((data.get('licenceUrl', null) == null
                 && data.get('licenceType', null) == null)
              || (data.get('licenceUrl', null) != null
                 && data.get('licenceType', null) in ['pdf', 'image']));
      }

      // Juvenile side names (JSb): a club in both competitions may give its
      // juvenile sides their own name and short name, reserved in teamNames
      // like a club name (same batch). Without one they play as the club's
      // name with " B". A club in one competition has neither.
      function isValidJuvenileName(data, uid) {
        let name = data.get('juvenileName', null);
        return (name == null
            && data.get('juvenileShortName', null) == null
            && data.get('juvenileNameKey', null) == null)
          || (data.categories.size() == 2
            && isText(name, 2, 60)
            && data.get('juvenileShortName', '').matches('^[A-Z]{3,4}$')
            && data.juvenileShortName != data.shortName
            && data.get('juvenileNameKey', '').matches('^[a-z0-9-]{2,60}$')
            && data.juvenileNameKey != data.nameKey
            && getAfter(teamNameDoc(data.juvenileNameKey)).data.uid == uid);
      }

      function isValidTeamRequest(data, uid) {
        return data.keys().hasOnly([
            'teamName', 'teamNameLower', 'nameKey', 'shortName', 'town',
            'homeGround', 'categories', 'homeGroundDirections', 'yearFounded', 'email',
            'logoUrl', 'kits', 'officials', 'agreedToRules', 'status',
            'rejectionReason', 'createdAt', 'updatedAt',
            'reviewedAt', 'reviewedBy', 'teamId',
            'clubStatus', 'lastLeague', 'letterUrl', 'licenceUrl', 'licenceType',
            'juvenileKits', 'colours', 'season',
            'juvenileName', 'juvenileShortName', 'juvenileNameKey'
          ])
          && isText(data.teamName, 2, 60)
          && (data.get('season', null) == null || isSeason(data.season))
          && data.teamNameLower == data.teamName.lower()
          && data.nameKey is string
          && data.nameKey.matches('^[a-z0-9-]{2,60}$')
          && data.shortName is string
          && data.shortName.matches('^[A-Z]{3,4}$')
          && isText(data.town, 2, 60)
          && isText(data.homeGround, 2, 80)
          && isOptionalText(data, 'homeGroundDirections', 300)
          && isOptionalText(data, 'email', 120)
          // The logo is required (2.13)
          && isText(data.logoUrl, 10, 2000)
          && isValidClubStatus(data)
          && data.categories is list
          && data.categories.size() >= 1
          && data.categories.size() <= 2
          && data.categories.hasOnly(['division', 'juvenile'])
          && data.categories.toSet().size() == data.categories.size()
          && (!('yearFounded' in data) || data.yearFounded == null
              || (data.yearFounded is int
                  && data.yearFounded >= 1900 && data.yearFounded <= 2100))
          && isValidKitSet(data.kits)
          // A club in both competitions has separate juvenile kits (2.13b)
          && ((data.categories.size() == 2
                 && isValidKitSet(data.get('juvenileKits', null)))
              || (data.categories.size() == 1
                 && data.get('juvenileKits', null) == null))
          && isValidTeamColours(data.get('colours', null))
          && isValidJuvenileName(data, uid)
          && data.officials is list
          && data.officials.size() >= 2
          && data.officials.size() <= 7
          && data.agreedToRules == true
          && data.status == 'pending'
          && (!('rejectionReason' in data) || data.rejectionReason == null)
          && data.updatedAt == request.time
          && getAfter(teamNameDoc(data.nameKey)).data.uid == uid;
      }

      // FA approves: only the review fields change. In the same batch the
      // team is created and the club's account becomes its team admin.
      function isApproval(uid) {
        let after = request.resource.data;
        return after.status == 'approved'
          && after.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'teamId', 'reviewedAt', 'reviewedBy', 'updatedAt'])
          && after.teamId == resource.data.nameKey
          && getAfter(teamDoc(after.teamId)).data.requestUid == uid
          && getAfter(userDoc(uid)).data.role == 'teamAdmin'
          && getAfter(userDoc(uid)).data.teamId == after.teamId
          // The season fee must be started: at least one payment
          // confirmed (2.13c). Requests from before 2.13c count as 2026-27.
          && isFeeStarted(resource.data.get('season', '2026-27'), uid);
      }

      // FA rejects: status and a real reason (10 to 500 characters).
      function isRejection() {
        let after = request.resource.data;
        return after.status == 'rejected'
          && after.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'rejectionReason', 'reviewedAt', 'reviewedBy', 'updatedAt'])
          && isText(after.rejectionReason, 10, 500);
      }

      match /teamRequests/{uid} {
        allow get: if isOwner(uid) || isFaAdmin();
        allow list: if isFaAdmin();

        allow create: if isOwner(uid)
          && hasConfirmedEmail()
          // The FA can close team registration (2.13d)
          && leagueValue('teamRegistrationOpen', true) == true
          && isValidTeamRequest(request.resource.data, uid)
          && !request.resource.data.keys().hasAny(['reviewedAt', 'reviewedBy', 'teamId'])
          && request.resource.data.createdAt == request.time;

        // The club edits its own request (pending or rejected).
        // It can never touch the FA's review fields.
        allow update: if isOwner(uid)
          && hasConfirmedEmail()
          && resource.data.status in ['pending', 'rejected']
          && isValidTeamRequest(request.resource.data, uid)
          && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['reviewedAt', 'reviewedBy', 'teamId'])
          && request.resource.data.createdAt == resource.data.createdAt;

        // The FA approves or rejects a pending request.
        allow update: if isFaAdmin()
          && resource.data.status == 'pending'
          && request.resource.data.reviewedBy == request.auth.uid
          && request.resource.data.reviewedAt == request.time
          && request.resource.data.updatedAt == request.time
          && (isApproval(uid) || isRejection());
      }

      // ---------- teamChanges/{teamId}_{kind} (2.10b) ----------
      // A team asks the FA to change its name, short name or logo, or to
      // add a competition. One document per team and kind, so there is
      // only ever one pending request of each kind. Asking again after
      // the FA decided replaces the old one.

      // What the team sends: the new value, the old one (for the FA's
      // "Now"), and why. Checked against the team as it is now.
      // A club's own juvenile name (JSc): 2–60 characters and not the
      // club's name; a 3–4 capital short name that isn't the club's; a
      // name key that isn't the club's and is free or already this club's.
      function isOwnJuvenileName(name, shortName, nameKey, team, teamId) {
        return isText(name, 2, 60)
          && name.lower() != team.name.lower()
          && shortName is string
          && shortName.matches('^[A-Z]{3,4}$')
          && shortName != team.get('shortName', '')
          && nameKey is string
          && nameKey.matches('^[a-z0-9-]{2,60}$')
          && nameKey != teamId
          && (!exists(teamNameDoc(nameKey))
              || get(teamNameDoc(nameKey)).data.uid == team.requestUid);
      }

      function isValidTeamChange(data, changeId) {
        let team = get(teamDoc(data.teamId)).data;
        return data.keys().hasOnly(['teamId', 'teamName', 'kind', 'from', 'to',
                                    'nameKey', 'reason', 'status', 'askedBy',
                                    'askedByName', 'createdAt', 'updatedAt',
                                    'fromShortName', 'toShortName',
                                    'juvenileName', 'juvenileShortName'])
          && changeId == data.teamId + '_' + data.kind
          && data.teamName == team.name
          // Juvenile fields only on their own kinds
          && (data.kind == 'juvenileName'
              || !data.keys().hasAny(['fromShortName', 'toShortName']))
          && (data.kind == 'competition'
              || !data.keys().hasAny(['juvenileName', 'juvenileShortName']))
          // "Why" is optional for a juvenile side's name (mockup JS3b)
          && (isText(data.get('reason', null), 5, 300)
              || (data.kind == 'juvenileName' && data.get('reason', null) == ''))
          && isOptionalText(data, 'askedByName', 80)
          && data.askedBy == request.auth.uid
          && data.status == 'pending'
          && data.createdAt == request.time
          && data.updatedAt == request.time
          && ((data.kind == 'name'
                && isText(data.to, 2, 60)
                && data.to != team.name
                && data.from == team.name
                && data.nameKey is string
                && data.nameKey.matches('^[a-z0-9-]{2,60}$')
                // Free, or already this club's (e.g. its old name)
                && (!exists(teamNameDoc(data.nameKey))
                    || get(teamNameDoc(data.nameKey)).data.uid == team.requestUid))
              || (data.kind == 'shortName'
                && data.to is string
                && data.to.matches('^[A-Z]{3,4}$')
                && data.to != team.get('shortName', '')
                && data.from == team.get('shortName', ''))
              || (data.kind == 'logo'
                && isText(data.to, 10, 2000)
                && data.to != team.get('logoUrl', null)
                && data.from == team.get('logoUrl', null))
              // Add the competition the club is not in yet. Adding Juvenile
              // may name the juvenile side too ("B" without one, JSc).
              || (data.kind == 'competition'
                && data.to in ['division', 'juvenile']
                && !(data.to in team.categories)
                && data.from == team.categories
                && (data.get('juvenileName', null) == null
                    ? (data.get('juvenileShortName', null) == null
                       && data.get('nameKey', null) == null)
                    : (data.to == 'juvenile'
                       && isOwnJuvenileName(data.juvenileName,
                            data.get('juvenileShortName', null),
                            data.get('nameKey', null), team, data.teamId))))
              // The juvenile side's name (JSc): its own name, or back to "B"
              // (to = ''). "From" is how it plays now.
              || (data.kind == 'juvenileName'
                && team.get('categories', []).size() == 2
                && [data.get('from', ''), data.get('fromShortName', '')]
                     == sideNamesOf(team, 'juvenile')
                && ((data.to == ''
                      && data.get('toShortName', '') == ''
                      && data.get('nameKey', null) == null
                      && team.get('juvenileName', null) != null)
                    || ([data.to, data.get('toShortName', null)]
                          != [team.get('juvenileName', null), team.get('juvenileShortName', null)]
                      && isOwnJuvenileName(data.to, data.get('toShortName', null),
                           data.get('nameKey', null), team, data.teamId)))));
      }

      // The FA approves: the team really has the new value after the batch
      // (and a new name is reserved for the club).
      function isTeamChangeApplied(change) {
        let team = getAfter(teamDoc(change.teamId)).data;
        return (change.kind == 'name'
              && team.name == change.to
              && getAfter(teamNameDoc(change.nameKey)).data.uid == team.requestUid)
          || (change.kind == 'shortName' && team.shortName == change.to)
          || (change.kind == 'logo' && team.logoUrl == change.to)
          || (change.kind == 'competition'
              && change.to in team.categories
              && team.get('juvenileName', null) == change.get('juvenileName', null)
              && team.get('juvenileShortName', null) == change.get('juvenileShortName', null)
              && (change.get('nameKey', null) == null
                  || getAfter(teamNameDoc(change.nameKey)).data.uid == team.requestUid))
          // JSc: the own name (reserved for the club), or "B" (no name)
          || (change.kind == 'juvenileName'
              && (change.to == ''
                  ? (team.get('juvenileName', null) == null
                     && team.get('juvenileShortName', null) == null)
                  : (team.get('juvenileName', null) == change.to
                     && team.get('juvenileShortName', null) == change.toShortName
                     && getAfter(teamNameDoc(change.nameKey)).data.uid == team.requestUid)));
      }

      match /teamChanges/{changeId} {
        allow get, list: if isFaAdmin() || isTeamAdminOf(resource.data.teamId);

        // The team asks, for its own team only (not while suspended, 2.11c)
        allow create: if isTeamAdminOf(request.resource.data.teamId)
          && !isSuspended(request.resource.data.teamId)
          && isValidTeamChange(request.resource.data, changeId);

        // ...and asks again once the FA has decided the last one
        allow update: if isTeamAdminOf(request.resource.data.teamId)
          && !isSuspended(request.resource.data.teamId)
          && resource.data.status != 'pending'
          && isValidTeamChange(request.resource.data, changeId);

        // The FA approves (the team changes in the same batch) or
        // refuses with a reason the team will see.
        allow update: if isFaAdmin()
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'rejectionReason', 'reviewedBy', 'reviewedAt', 'updatedAt'])
          && request.resource.data.reviewedBy == request.auth.uid
          && request.resource.data.reviewedAt == request.time
          && request.resource.data.updatedAt == request.time
          && ((request.resource.data.status == 'approved'
                && request.resource.data.get('rejectionReason', null) == null
                && isTeamChangeApplied(resource.data))
              || (request.resource.data.status == 'rejected'
                && isText(request.resource.data.get('rejectionReason', null), 10, 500)));
      }

      // ---------- correctionRequests/{teamId} (2.11b) ----------
      // The FA asks an approved team to correct something it should fix
      // itself (officials are sensitive; kits, colours, players…). One
      // per team: asked -> sentBack (by the team) -> done, or asked again.
      function isCorrectionAsk(data, teamId) {
        return data.keys().hasOnly(['teamId', 'teamName', 'items', 'message',
                                    'status', 'askedBy', 'askedByName',
                                    'askedAt', 'round', 'updatedAt'])
          && data.teamId == teamId
          && data.teamName == get(teamDoc(teamId)).data.name
          && data.items is list
          && data.items.size() >= 1
          && data.items.size() <= 4
          && data.items.hasOnly(['clubDetails', 'officials', 'kits', 'players'])
          && isText(data.message, 10, 500)
          && data.status == 'asked'
          && data.askedBy == request.auth.uid
          && isOptionalText(data, 'askedByName', 80)
          && data.askedAt == request.time
          && data.updatedAt == request.time
          && data.round is int;
      }

      match /correctionRequests/{teamId} {
        allow get: if isFaAdmin() || isTeamAdminOf(teamId);
        allow list: if isFaAdmin();

        // The first request for this team
        allow create: if isFaAdmin()
          && exists(teamDoc(teamId))
          && isCorrectionAsk(request.resource.data, teamId)
          && request.resource.data.round == 1;

        // Ask again: after the team sent it back, or a new request once
        // the last one is done. Never while the team is still on it.
        allow update: if isFaAdmin()
          && resource.data.status in ['sentBack', 'done']
          && isCorrectionAsk(request.resource.data, teamId)
          && request.resource.data.round == resource.data.round + 1;

        // The team sends it back once it has fixed it
        allow update: if isTeamAdminOf(teamId)
          && resource.data.status == 'asked'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'sentBackAt', 'sentBackBy', 'updatedAt'])
          && request.resource.data.status == 'sentBack'
          && request.resource.data.sentBackBy == request.auth.uid
          && request.resource.data.sentBackAt == request.time
          && request.resource.data.updatedAt == request.time;

        // The FA checks it and marks it done
        allow update: if isFaAdmin()
          && resource.data.status == 'sentBack'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'doneAt', 'doneBy', 'updatedAt'])
          && request.resource.data.status == 'done'
          && request.resource.data.doneBy == request.auth.uid
          && request.resource.data.doneAt == request.time
          && request.resource.data.updatedAt == request.time;
      }

      // ---------- teamNames/{nameKey} ----------

      // A name the signed-in club's request uses (after this write): its
      // club name, or its juvenile side's own name (JSb)
      function isMyRequestName(nameKey) {
        let req = getAfter(teamRequestDoc(request.auth.uid)).data;
        return req.nameKey == nameKey || req.get('juvenileNameKey', null) == nameKey;
      }

      // The FA approves a change that reserves [nameKey] for the team: a new
      // club name (2.10b), or a juvenile side's own name (JSc)
      function isApprovedNameKey(teamId, kind, nameKey) {
        let change = teamChangeDoc(teamId, kind);
        return existsAfter(change)
          && getAfter(change).data.status == 'approved'
          && getAfter(change).data.get('nameKey', null) == nameKey;
      }

      match /teamNames/{nameKey} {
        allow get: if isSignedIn();

        allow create: if isOwner(request.resource.data.uid)
          && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
          && request.resource.data.createdAt == request.time
          && isMyRequestName(nameKey);

        // The FA approves a new club name (2.10b): the new name is reserved
        // for the club in the same batch. The old one stays the club's too.
        allow create: if isFaAdmin()
          && request.resource.data.keys().hasOnly(['uid', 'teamId', 'createdAt'])
          && request.resource.data.createdAt == request.time
          && (isApprovedNameKey(request.resource.data.teamId, 'name', nameKey)
              || isApprovedNameKey(request.resource.data.teamId, 'juvenileName', nameKey)
              || isApprovedNameKey(request.resource.data.teamId, 'competition', nameKey))
          && request.resource.data.uid == get(teamDoc(request.resource.data.teamId)).data.requestUid;

        // ...or corrects the spelling of a club's name itself (2.11a)
        allow create: if isFaAdmin()
          && request.resource.data.keys().hasOnly(['uid', 'teamId', 'createdAt'])
          && request.resource.data.createdAt == request.time
          && isCorrectingNameTo(request.resource.data.teamId, nameKey)
          && request.resource.data.uid == get(teamDoc(request.resource.data.teamId)).data.requestUid;

        // A team's name (one with a teamId) is never given up by the club
        allow delete: if isOwner(resource.data.uid)
          && !('teamId' in resource.data)
          && (!existsAfter(teamRequestDoc(request.auth.uid))
              || !isMyRequestName(nameKey));
      }

      // ---------- fixtures/{fixtureId} (3.0a) ----------

      function fixtureDoc(fixtureId) {
        return /databases/$(database)/documents/districts/$(districtId)/fixtures/$(fixtureId);
      }

      // The kits a team wears in a competition: a club in both keeps
      // separate juvenile kits (2.13b)
      function kitsOf(team, category) {
        return category == 'juvenile' && team.get('juvenileKits', {}).size() > 0
          ? team.juvenileKits
          : team.get('kits', {});
      }

      // { slot, kit }: one of the team's own kits ([kits], from kitsOf),
      // copied exactly
      function isKitChoice(choice, kits, slots) {
        return choice is map
          && choice.keys().hasOnly(['slot', 'kit'])
          && choice.get('slot', '') in slots
          && kits.get(choice.slot, null) != null
          && choice.get('kit', null) == kits[choice.slot];
      }

      // One side of a match: { id, name, shortName, logoUrl, colour }.
      // Teams can't read other teams, so the match carries a copy; it must
      // match the team as it is now. The team must play this competition.
      function isFixtureSide(side, category, outfield, goalkeeper) {
        let team = get(teamDoc(side.id)).data;
        let kits = kitsOf(team, category);
        return side.keys().hasOnly(['id', 'name', 'shortName', 'logoUrl', 'colour'])
          && team.get('categories', []).hasAny([category])
          && [side.get('name', ''), side.get('shortName', '')] == sideNamesOf(team, category)
          && side.get('logoUrl', null) == team.get('logoUrl', null)
          && isHexColour(side.get('colour', null))
          && isKitChoice(outfield, kits, ['home', 'away', 'third'])
          && isKitChoice(goalkeeper, kits, ['goalkeeper', 'goalkeeper2']);
      }

      // A match. A league match's competition is '<season>_<category>-league'
      // (cups come in 3.0c). Kick-off is empty only while postponed with no
      // new date. Postponed and cancelled need a reason the teams can read.
      function isValidFixture(data) {
        return data.keys().hasOnly([
            'season', 'competitionId', 'category', 'ageGroup', 'round',
            'teamIds', 'home', 'away', 'kits', 'kickoffAt', 'venue', 'status',
            'note', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt',
            'previousNames'
          ])
          && data.keys().hasAll([
            'season', 'competitionId', 'category', 'round', 'teamIds', 'home',
            'away', 'kits', 'kickoffAt', 'venue', 'status', 'createdBy',
            'createdAt', 'updatedBy', 'updatedAt'
          ])
          && isSeason(data.season)
          && data.category in ['division', 'juvenile']
          && (data.category == 'juvenile'
              ? data.get('ageGroup', '') in ['U13', 'U15', 'U17']
              : !('ageGroup' in data))
          && data.competitionId == data.season + '_' + data.category + '-league'
          && data.round is int && data.round >= 1 && data.round <= 99
          && data.home is map && data.away is map && data.kits is map
          && data.home.get('id', '') is string && data.away.get('id', '') is string
          && data.home.id != data.away.id
          && data.teamIds == [data.home.id, data.away.id]
          && data.kits.keys().hasOnly(['home', 'away', 'homeGk', 'awayGk'])
          && data.kits.keys().hasAll(['home', 'away', 'homeGk', 'awayGk'])
          && isFixtureSide(data.home, data.category, data.kits.home, data.kits.homeGk)
          && isFixtureSide(data.away, data.category, data.kits.away, data.kits.awayGk)
          && isText(data.venue, 2, 80)
          && data.status in ['scheduled', 'postponed', 'cancelled']
          && (data.kickoffAt is timestamp
              || (data.kickoffAt == null && data.status == 'postponed'))
          && isOptionalText(data, 'note', 200)
          && (data.status == 'scheduled' || isText(data.get('note', ''), 3, 200))
          && data.updatedBy == request.auth.uid
          && data.updatedAt == request.time;
      }

      // JSc2: one side of a match after the FA renamed its team (a new club
      // name, short name or juvenile side name). Only its name and short
      // name change, to the team's names as they are now. A new name keeps
      // the one before in previousNames ({ name, until }) for the gold
      // "Previously ..." pill; a new short name alone keeps no pill.
      function isRenamedSide(before, after, category, prev, prevBefore) {
        let id = before.id;
        return (after == before
              && prev.get(id, null) == prevBefore.get(id, null))
          || (after.diff(before).affectedKeys().hasOnly(['name', 'shortName'])
              && [after.name, after.shortName]
                   == sideNamesOf(getAfter(teamDoc(id)).data, category)
              && (after.name == before.name
                  ? prev.get(id, null) == prevBefore.get(id, null)
                  : (prev.get(id, null) is map
                     && prev[id].keys().hasOnly(['name', 'until'])
                     && prev[id].name == before.name
                     && prev[id].until is timestamp)));
      }

      // JSc2: the FA renames a team in its matches, played ones too (even
      // cancelled ones). Nothing else in the match changes.
      function isRenamingMatch() {
        let before = resource.data;
        let after = request.resource.data;
        let prev = after.get('previousNames', {});
        let prevBefore = before.get('previousNames', {});
        return after.diff(before).affectedKeys()
                 .hasOnly(['home', 'away', 'previousNames', 'updatedBy', 'updatedAt'])
          && after.updatedBy == request.auth.uid
          && after.updatedAt == request.time
          && prev is map
          && prev.keys().hasOnly([before.home.id, before.away.id])
          && isRenamedSide(before.home, after.home, before.category, prev, prevBefore)
          && isRenamedSide(before.away, after.away, before.category, prev, prevBefore);
      }

      match /fixtures/{fixtureId} {
        // The schedule is for everyone with a role (teams, referees, FA)
        allow get, list: if hasRole();

        // The FA adds a match: always scheduled, kick-off in the future
        allow create: if isFaAdmin()
          && isValidFixture(request.resource.data)
          && !('previousNames' in request.resource.data)
          && request.resource.data.status == 'scheduled'
          && request.resource.data.kickoffAt > request.time
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;

        // The FA changes, postpones or cancels it. A cancelled match is
        // final, and cancelling keeps its date. A new date is in the future.
        allow update: if isFaAdmin()
          // "Previously" changes only with a rename (below); checked first,
          // so a rename doesn't spend the 1000-expression limit here
          && request.resource.data.get('previousNames', null)
               == resource.data.get('previousNames', null)
          && resource.data.status != 'cancelled'
          && isValidFixture(request.resource.data)
          && request.resource.data.season == resource.data.season
          && request.resource.data.competitionId == resource.data.competitionId
          && request.resource.data.category == resource.data.category
          && request.resource.data.get('ageGroup', null) == resource.data.get('ageGroup', null)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && (request.resource.data.status != 'cancelled'
              || request.resource.data.kickoffAt == resource.data.kickoffAt)
          && (request.resource.data.kickoffAt == resource.data.kickoffAt
              || request.resource.data.kickoffAt == null
              || request.resource.data.kickoffAt > request.time);

        // The FA renames a team in its matches (JSc2)
        allow update: if isFaAdmin() && isRenamingMatch();

        // Never deleted: cancel it instead, so the teams keep the record

        // fixtures/{id}/history/{entryId}: every change, written with it
        match /history/{entryId} {
          allow get, list: if hasRole();
          allow create: if isFaAdmin()
            && request.resource.data.keys().hasOnly(['what', 'reason', 'by', 'byName', 'at'])
            && isText(request.resource.data.what, 3, 400)
            && isOptionalText(request.resource.data, 'reason', 200)
            && request.resource.data.by == request.auth.uid
            && isText(request.resource.data.byName, 1, 80)
            && request.resource.data.at == request.time
            && existsAfter(fixtureDoc(fixtureId));
        }
      }

      // ---------- fixtureDrafts/{draftId} (3.0b) ----------
      // "Make the season": a draft the FA saved for later. FA only; nobody
      // else sees it. Each match is checked when it is published.
      match /fixtureDrafts/{draftId} {
        allow get, list, delete: if isFaAdmin();
        allow create, update: if isFaAdmin()
          && request.resource.data.keys().hasOnly([
               'season', 'competitionId', 'category', 'ageGroup', 'settings',
               'teamIds', 'matches', 'updatedBy', 'updatedAt'
             ])
          && isSeason(request.resource.data.season)
          && request.resource.data.category in ['division', 'juvenile']
          && request.resource.data.competitionId
               == request.resource.data.season + '_' + request.resource.data.category + '-league'
          && request.resource.data.settings is map
          && request.resource.data.teamIds is list
          && request.resource.data.teamIds.size() <= 40
          && request.resource.data.matches is list
          && request.resource.data.matches.size() <= 1600
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;
      }

      // ---------- postponeJobs/{competitionId} (3.0c1d) ----------
      // A league's postpone while it runs: every match with its old and new
      // kick-off, saved before any match moves, and ticked off ('done') in
      // the same batch as each match. FA only. Its ID is the league, so a
      // league has one at a time: a second postpone waits until it is
      // finished. Deleted with the last notes when finished.
      match /postponeJobs/{competitionId} {
        allow get, list, delete: if isFaAdmin();

        allow create: if isFaAdmin()
          && request.resource.data.keys().hasOnly([
               'season', 'competitionId', 'category', 'name', 'days', 'reason',
               'moves', 'done', 'byName', 'startedBy', 'startedAt',
               'updatedBy', 'updatedAt'
             ])
          && request.resource.data.keys().hasAll([
               'season', 'competitionId', 'category', 'name', 'days', 'reason',
               'moves', 'done', 'byName', 'startedBy', 'startedAt',
               'updatedBy', 'updatedAt'
             ])
          && isSeason(request.resource.data.season)
          && request.resource.data.category in ['division', 'juvenile']
          && request.resource.data.competitionId == competitionId
          && competitionId
               == request.resource.data.season + '_' + request.resource.data.category + '-league'
          && isText(request.resource.data.name, 3, 40)
          && request.resource.data.days is int
          && request.resource.data.days >= 1 && request.resource.data.days <= 365
          && isText(request.resource.data.reason, 3, 200)
          && request.resource.data.moves is list
          && request.resource.data.moves.size() >= 1
          && request.resource.data.moves.size() <= 1600
          && request.resource.data.done == []
          && isText(request.resource.data.byName, 1, 80)
          && request.resource.data.startedBy == request.auth.uid
          && request.resource.data.startedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;

        // Ticking matches off: only 'done' changes, it only grows, and never
        // past the number of matches
        allow update: if isFaAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['done', 'updatedBy', 'updatedAt'])
          && request.resource.data.done is list
          && request.resource.data.done.hasAll(resource.data.done)
          && request.resource.data.done.size() <= request.resource.data.moves.size()
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;
      }

      // ---------- cups/{cupId} (3.0c) ----------

      // A gala's ground and days: { ground, firstDay, lastDay, kickoffHour,
      // kickoffMinute, gapMinutes }
      function isValidGala(gala) {
        return gala is map
          && gala.keys().hasOnly(['ground', 'firstDay', 'lastDay', 'kickoffHour', 'kickoffMinute', 'gapMinutes'])
          && gala.keys().hasAll(['ground', 'firstDay', 'lastDay', 'kickoffHour', 'kickoffMinute', 'gapMinutes'])
          && isText(gala.ground, 2, 80)
          && gala.firstDay is timestamp
          && gala.lastDay is timestamp
          && gala.lastDay >= gala.firstDay
          && gala.kickoffHour is int && gala.kickoffHour >= 0 && gala.kickoffHour <= 23
          && gala.kickoffMinute is int && gala.kickoffMinute >= 0 && gala.kickoffMinute <= 59
          && gala.gapMinutes is int && gala.gapMinutes >= 30 && gala.gapMinutes <= 240;
      }

      // A cup or a gala. The sides in it ({ teamId, category }) are not
      // checked one by one: each match is checked when the draw saves it.
      // A replay only with one-match rounds (GEDFA, 8 Nov 2026). A gala is
      // a straight knockout, one match per tie, at one ground.
      function isValidCup(data) {
        return data.keys().hasOnly([
            'season', 'kind', 'name', 'category', 'ageGroup', 'entries',
            'format', 'legs', 'level', 'bracketFrom',
            'seeded', 'stage', 'gala', 'createdBy', 'createdAt', 'updatedBy',
            'updatedAt'
          ])
          && data.keys().hasAll([
            'season', 'kind', 'name', 'category', 'entries', 'format', 'legs',
            'level', 'bracketFrom', 'seeded', 'stage',
            'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
          ])
          && isSeason(data.season)
          && data.kind in ['cup', 'gala']
          && isText(data.name, 3, 60)
          && data.category in ['division', 'juvenile', 'open']
          && (data.category == 'division'
              ? !('ageGroup' in data)
              : data.get('ageGroup', '') in ['U13', 'U15', 'U17'])
          && data.entries is list
          && data.entries.size() >= 2 && data.entries.size() <= 64
          && data.format in ['knockout', 'groups']
          && data.legs in [1, 2]
          && data.level in ['penalties', 'extraTime', 'replay']
          && (data.level != 'replay' || data.legs == 1)
          && data.bracketFrom in [0, 4, 8, 16, 32]
          && data.seeded is bool
          && (data.kind == 'gala'
              ? data.format == 'knockout' && data.legs == 1
                && data.level != 'replay' && !data.seeded
                && isValidGala(data.get('gala', null))
              : !('gala' in data))
          && data.updatedBy == request.auth.uid
          && data.updatedAt == request.time;
      }

      // A line in a cup's history (3.0c1b): what changed, who and when. Only
      // with its cup (made, changed or still there in the same batch).
      function isValidCupLine(cupId, data) {
        return data.keys().hasOnly(['text', 'by', 'byName', 'at'])
          && data.keys().hasAll(['text', 'by', 'byName', 'at'])
          && isText(data.text, 3, 200)
          && isText(data.byName, 1, 80)
          && data.by == request.auth.uid
          && data.at == request.time
          && existsAfter(/databases/$(database)/documents/districts/$(districtId)/cups/$(cupId));
      }

      match /cups/{cupId} {
        // Everyone with a role sees the cups (teams see their path, C6)
        allow get, list: if hasRole();

        // The FA makes one; it starts not drawn (the draw comes in 3.0c2)
        allow create: if isFaAdmin()
          && isValidCup(request.resource.data)
          && request.resource.data.stage == 'notDrawn'
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;

        // "Change" (3.0c1b, C8): only before the draw, same season, and who
        // made it and when stay as they were. The draw (3.0c2) moves it on.
        allow update: if isFaAdmin()
          && isValidCup(request.resource.data)
          && resource.data.stage == 'notDrawn'
          && request.resource.data.stage == 'notDrawn'
          && request.resource.data.season == resource.data.season
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;

        // "Delete the cup" (C9): at any time, everything goes (GEDFA, 8 Nov
        // 2026)
        allow delete: if isFaAdmin();

        match /history/{lineId} {
          allow get, list: if hasRole();
          allow create: if isFaAdmin()
            && isValidCupLine(cupId, request.resource.data);
          // Never changed; deleted only with the cup
          allow delete: if isFaAdmin();
        }
      }

      // ---------- teams/{teamId} ----------

      // Each part of a team edit is checked only when it changes, so teams
      // approved before 2.13b can still be edited (2.10a, 2.11a).
      function isValidTeamEdit(after, changed) {
        return (!changed.hasAny(['town']) || isText(after.town, 2, 60))
          && (!changed.hasAny(['homeGround']) || isText(after.homeGround, 2, 80))
          && isOptionalText(after, 'homeGroundDirections', 300)
          && (!changed.hasAny(['colours']) || isValidTeamColours(after.colours))
          && (!changed.hasAny(['kits']) || isValidKitSet(after.kits))
          // Separate juvenile kits only for a club in both competitions
          && (!changed.hasAny(['juvenileKits'])
              || (after.categories.size() == 2 && isValidKitSet(after.juvenileKits)))
          && (!changed.hasAny(['officials'])
              || (after.officials is list
                  && after.officials.size() >= 2 && after.officials.size() <= 7));
      }

      // 2.10a: what a team admin changes straight away on the team
      // profile (no FA approval): town, home ground, colours, kits and
      // officials. Name, short name, logo and competitions are NOT here:
      // they need an FA request (2.10b).
      function isTeamDirectEdit() {
        let after = request.resource.data;
        let changed = after.diff(resource.data).affectedKeys();
        return changed.hasOnly(['town', 'homeGround', 'homeGroundDirections',
                                'colours', 'kits', 'juvenileKits', 'officials',
                                'updatedAt'])
          && after.updatedAt == request.time
          && isValidTeamEdit(after, changed);
      }

      // 2.11a: the FA corrects a misspelling or an obvious mistake on an
      // approved team itself: the club name, town, ground, directions,
      // year founded or email. Anything else (kits, colours, officials,
      // which are sensitive) the FA asks the team to correct (2.11b). The
      // same batch writes the log line, and its fields are exactly what
      // changed. A new spelling of the name is reserved for the club.
      function isFaCorrection(teamId) {
        let before = resource.data;
        let after = request.resource.data;
        let changed = after.diff(before).affectedKeys();
        let fields = changed.difference(['nameLower', 'lastCorrectionId', 'updatedAt'].toSet());
        let log = newCorrectionOf(teamId);
        return changed.hasOnly(['name', 'nameLower', 'town', 'homeGround',
                                'homeGroundDirections', 'yearFounded', 'email',
                                'lastCorrectionId', 'updatedAt'])
          && after.updatedAt == request.time
          && changed.hasAny(['lastCorrectionId'])
          && fields.size() > 0
          && log != null
          && log.fields.toSet() == fields
          && isValidTeamEdit(after, changed)
          && isOptionalText(after, 'email', 120)
          && (!changed.hasAny(['yearFounded']) || after.yearFounded == null
              || (after.yearFounded is int
                  && after.yearFounded >= 1900 && after.yearFounded <= 2100))
          && (!changed.hasAny(['nameLower']) || changed.hasAny(['name']))
          && (!changed.hasAny(['name'])
              || (isText(after.name, 2, 60)
                  && after.nameLower == after.name.lower()
                  && getAfter(teamNameDoc(log.nameKey)).data.uid == before.requestUid));
      }

      // 2.11c: the chairman suspends a team that isn't suspended now. The
      // same batch writes its line in the team's history.
      function isSuspending(teamId) {
        let before = resource.data;
        let after = request.resource.data;
        let s = after.get('suspension', null);
        return after.diff(before).affectedKeys().hasOnly(['suspension', 'updatedAt'])
          && after.updatedAt == request.time
          && !isActiveSuspension(before.get('suspension', null))
          && s is map
          && s.keys().hasOnly(['id', 'reason', 'since', 'until', 'byUid', 'byName'])
          && s.get('id', null) is string
          && isText(s.get('reason', null), 10, 500)
          && s.get('since', null) == request.time
          && (s.get('until', null) == null
              || (s.until is timestamp && s.until > request.time))
          && s.get('byUid', null) == request.auth.uid
          && isOptionalText(s, 'byName', 80)
          && getAfter(suspensionDoc(teamId, s.id)).data.since == request.time;
      }

      // 2.11c: the chairman lifts it (also an ended dated one); the
      // history line gets why, in the same batch.
      function isLiftingSuspension(teamId) {
        let before = resource.data;
        let after = request.resource.data;
        return after.diff(before).affectedKeys().hasOnly(['suspension', 'updatedAt'])
          && after.updatedAt == request.time
          && before.get('suspension', null) != null
          && after.get('suspension', null) == null
          && getAfter(suspensionDoc(teamId, before.suspension.id)).data
               .get('liftedAt', null) == request.time;
      }

      // The team's request of this kind goes from pending to approved in
      // this same batch (2.10b).
      function isApprovingChange(teamId, kind) {
        let change = teamChangeDoc(teamId, kind);
        return exists(change)
          && get(change).data.status == 'pending'
          && getAfter(change).data.status == 'approved';
      }

      // 2.10b: the FA applies an approved change to the team. Only the
      // fields of that one kind change, to exactly what the team asked.
      function isFaTeamChange(teamId) {
        let before = resource.data;
        let after = request.resource.data;
        let changed = after.diff(before).affectedKeys();
        return after.updatedAt == request.time
          && ((changed.hasAny(['name'])
                && changed.hasOnly(['name', 'nameLower', 'updatedAt'])
                && isApprovingChange(teamId, 'name')
                && after.name == get(teamChangeDoc(teamId, 'name')).data.to
                && after.nameLower == after.name.lower())
              || (changed.hasAny(['shortName'])
                && changed.hasOnly(['shortName', 'updatedAt'])
                && isApprovingChange(teamId, 'shortName')
                && after.shortName == get(teamChangeDoc(teamId, 'shortName')).data.to)
              || (changed.hasAny(['logoUrl'])
                && changed.hasOnly(['logoUrl', 'updatedAt'])
                && isApprovingChange(teamId, 'logo')
                && after.logoUrl == get(teamChangeDoc(teamId, 'logo')).data.to)
              // Adding a competition: the club is then in both. A
              // Juvenile-only club's kits become its juvenile kits (and stay
              // as its Division kits until it edits them).
              // JSc: the juvenile side's own name, or back to "B"
              || (changed.hasAny(['juvenileName', 'juvenileShortName'])
                && changed.hasOnly(['juvenileName', 'juvenileShortName', 'updatedAt'])
                && isApprovingChange(teamId, 'juvenileName'))
              || (changed.hasAny(['categories'])
                && changed.hasOnly(['categories', 'juvenileKits', 'juvenileName',
                                    'juvenileShortName', 'updatedAt'])
                && isApprovingChange(teamId, 'competition')
                && after.categories.size() == 2
                && after.categories.toSet() == before.categories.toSet()
                     .union([get(teamChangeDoc(teamId, 'competition')).data.to].toSet())
                && ((before.categories.hasAny(['juvenile'])
                      && after.get('juvenileKits', null) == before.kits)
                    || (before.categories.hasAny(['division'])
                      && after.get('juvenileKits', null) == null))));
      }

      match /teams/{teamId} {
        allow get: if isTeamAdminOf(teamId) || isFaAdmin();
        allow list: if isFaAdmin();

        // The team's own profile edits (2.10a), not while suspended (2.11c)
        allow update: if isTeamAdminOf(teamId) && isTeamDirectEdit()
          && !isSuspended(teamId);

        // The chairman suspends a team or lifts its suspension (2.11c)
        allow update: if isChairman()
          && (isSuspending(teamId) || isLiftingSuspension(teamId));

        // ---------- teams/{teamId}/suspensions/{suspensionId} (2.11c) ----------
        // The team's history: one line per suspension, written with it.
        // Lifting adds why (fine paid, bond signed, board decision, other).
        match /suspensions/{suspensionId} {
          allow get, list: if isFaAdmin() || isTeamAdminOf(teamId);

          allow create: if isChairman()
            && request.resource.data.keys().hasOnly(['reason', 'since', 'until', 'byUid', 'byName'])
            && getAfter(teamDoc(teamId)).data.suspension.id == suspensionId
            && request.resource.data.reason == getAfter(teamDoc(teamId)).data.suspension.reason
            && request.resource.data.get('until', null)
                 == getAfter(teamDoc(teamId)).data.suspension.get('until', null)
            && request.resource.data.since == request.time
            && request.resource.data.byUid == request.auth.uid
            && isOptionalText(request.resource.data, 'byName', 80);

          allow update: if isChairman()
            && !('liftedAt' in resource.data)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['liftedAt', 'liftReason', 'liftNote', 'liftedBy', 'liftedByName'])
            && request.resource.data.liftedAt == request.time
            && request.resource.data.liftedBy == request.auth.uid
            && request.resource.data.liftReason in ['finePaid', 'bondSigned', 'boardDecision', 'other']
            && isOptionalText(request.resource.data, 'liftNote', 300)
            // "Other" needs a note
            && (request.resource.data.liftReason != 'other'
                || isText(request.resource.data.get('liftNote', null), 5, 300))
            && isOptionalText(request.resource.data, 'liftedByName', 80)
            && getAfter(teamDoc(teamId)).data.get('suspension', null) == null;
        }

        // The FA applies a name, short name, logo or competition change it
        // approves (2.10b)
        allow update: if isFaAdmin() && isFaTeamChange(teamId);

        // The FA corrects a mistake itself, with a log line (2.11a)
        allow update: if isFaAdmin() && isFaCorrection(teamId);

        // ---------- teams/{teamId}/corrections/{correctionId} (2.11a) ----------
        // The FA's corrections log. Each line is written in the same batch
        // as the correction (the team points at it); never edited or deleted.
        match /corrections/{correctionId} {
          allow get, list: if isFaAdmin() || isTeamAdminOf(teamId);

          allow create: if isFaAdmin()
            && request.resource.data.keys().hasOnly(['section', 'fields', 'lines',
                 'reason', 'nameKey', 'byUid', 'byName', 'createdAt'])
            && request.resource.data.section in ['name', 'details']
            && request.resource.data.fields is list
            && request.resource.data.fields.size() >= 1
            && request.resource.data.fields.size() <= 12
            // What the team reads, e.g. "Home ground: Apam Prk → Apam Park"
            && request.resource.data.lines is list
            && request.resource.data.lines.size() >= 1
            && request.resource.data.lines.size() <= 20
            && isText(request.resource.data.get('reason', null), 5, 300)
            && request.resource.data.byUid == request.auth.uid
            && isOptionalText(request.resource.data, 'byName', 80)
            && request.resource.data.createdAt == request.time
            && getAfter(teamDoc(teamId)).data.get('lastCorrectionId', '') == correctionId
            && (!('name' in request.resource.data.fields)
                || (request.resource.data.get('nameKey', null) is string
                    && request.resource.data.nameKey.matches('^[a-z0-9-]{2,60}$')));
        }

        // FA approves a request: the team is created from it, in the same
        // batch as the approval. Its ID is the reserved team-name key.
        allow create: if isFaAdmin()
          && request.resource.data.requestUid is string
          && request.resource.data.nameKey == teamId
          && request.resource.data.adminUids == [request.resource.data.requestUid]
          && get(teamNameDoc(teamId)).data.uid == request.resource.data.requestUid
          && getAfter(teamRequestDoc(request.resource.data.requestUid)).data.status == 'approved'
          && getAfter(teamRequestDoc(request.resource.data.requestUid)).data.teamId == teamId
          // The juvenile side's own name, exactly as on the request (JSb)
          && request.resource.data.get('juvenileName', null)
               == getAfter(teamRequestDoc(request.resource.data.requestUid)).data.get('juvenileName', null)
          && request.resource.data.get('juvenileShortName', null)
               == getAfter(teamRequestDoc(request.resource.data.requestUid)).data.get('juvenileShortName', null)
          && request.resource.data.createdAt == request.time;

        // ---------- teams/{teamId}/jerseys/{jerseyId} ----------
        match /jerseys/{jerseyId} {
          allow get: if isTeamAdminOf(teamId) || isFaAdmin();

          // The FA too: passing a child in an older group moves their
          // reservation (juvenile-U13-9 -> juvenile-U15-9), 2.14c
          allow create: if (isTeamAdminOf(teamId) || isFaAdmin())
            && request.resource.data.keys().hasOnly(['playerId', 'createdAt'])
            && request.resource.data.createdAt == request.time
            && getAfter(playerDoc(request.resource.data.playerId)).data.teamId == teamId
            && jerseyIdOf(getAfter(playerDoc(request.resource.data.playerId)).data) == jerseyId;

          allow delete: if (isTeamAdminOf(teamId) || isFaAdmin())
            && (!existsAfter(playerDoc(resource.data.playerId))
                || jerseyIdOf(getAfter(playerDoc(resource.data.playerId)).data) != jerseyId);
        }

        // ---------- teams/{teamId}/armbands/{category} (2.3d) ----------
        // One captain and one vice-captain per squad. One document per
        // competition, so there can never be two captains.
        function isArmbandHolder(id, category) {
          return id == null
            || (get(playerDoc(id)).data.teamId == teamId
                && get(playerDoc(id)).data.category == category);
        }

        match /armbands/{category} {
          allow get: if isTeamAdminOf(teamId) || isFaAdmin();
          allow create, update: if isTeamAdminOf(teamId)
            && category in ['division', 'juvenile']
            && request.resource.data.keys().hasOnly(['captainId', 'viceCaptainId', 'updatedAt'])
            && isArmbandHolder(request.resource.data.get('captainId', null), category)
            && isArmbandHolder(request.resource.data.get('viceCaptainId', null), category)
            && (request.resource.data.get('captainId', null) == null
                || request.resource.data.get('captainId', null)
                     != request.resource.data.get('viceCaptainId', null))
            && request.resource.data.updatedAt == request.time;
        }
      }

      // ---------- playerProfiles/{playerId} (2.3d) ----------
      // Football details the team keeps up to date: no FA approval, and
      // they never change the player's registration. Private: the team
      // and the FA only (the emergency contact is in here).
      function isValidProfile(data, playerId) {
        return data.keys().hasOnly([
            'teamId', 'heightCm', 'weightKg', 'foot', 'otherPositions',
            'strengths', 'hometown', 'clubSince', 'previousClub',
            'availability', 'unavailableReason', 'expectedBack', 'availabilityAt',
            'emergencyName', 'emergencyPhone', 'updatedAt'
          ])
          && data.teamId == get(playerDoc(playerId)).data.teamId
          && (data.get('heightCm', null) == null
              || (data.heightCm is int && data.heightCm >= 120 && data.heightCm <= 220))
          && (data.get('weightKg', null) == null
              || (data.weightKg is int && data.weightKg >= 35 && data.weightKg <= 130))
          && (data.get('foot', null) == null || data.foot in ['left', 'right', 'both'])
          && (data.get('otherPositions', []) is list
              && data.get('otherPositions', []).size() <= 2
              && positionGroups().keys().hasAll(data.get('otherPositions', [])))
          && (data.get('strengths', []) is list
              && data.get('strengths', []).size() <= 3
              && ['pace', 'strength', 'stamina', 'dribbling', 'passing', 'finishing',
                  'heading', 'tackling', 'setPieces', 'leadership']
                   .hasAll(data.get('strengths', [])))
          && isOptionalText(data, 'hometown', 60)
          && isOptionalText(data, 'previousClub', 80)
          && (data.get('clubSince', null) == null
              || (data.clubSince is int && data.clubSince >= 1980
                  && data.clubSince <= request.time.year()))
          && data.availability in ['available', 'injured', 'unavailable']
          && (data.get('unavailableReason', null) == null
              || (data.availability == 'unavailable'
                  && data.unavailableReason in ['away', 'family', 'workOrSchool',
                                                'clubDiscipline', 'other']))
          && (data.get('expectedBack', null) == null || data.expectedBack is timestamp)
          && data.availabilityAt is timestamp
          && isOptionalText(data, 'emergencyName', 80)
          && isOptionalText(data, 'emergencyPhone', 20)
          && data.updatedAt == request.time;
      }

      match /playerProfiles/{playerId} {
        // (a profile not filled in yet doesn't exist: any team admin may
        // look, and finds nothing)
        allow read: if isFaAdmin()
          || (resource == null && isTeamAdmin())
          || isTeamAdminOf(resource.data.teamId);
        allow create, update: if isTeamAdminOf(request.resource.data.teamId)
          && isValidProfile(request.resource.data, playerId)
          && (resource == null || resource.data.teamId == request.resource.data.teamId);
      }

      // ---------- playerKeys/{key} ----------
      match /playerKeys/{key} {
        allow get: if isTeamAdmin() || isFaAdmin();

        allow create: if isTeamAdminOf(request.resource.data.teamId)
          && request.resource.data.keys().hasOnly(['playerId', 'teamId', 'createdAt'])
          && request.resource.data.createdAt == request.time
          && getAfter(playerDoc(request.resource.data.playerId)).data.playerKey == key
          && getAfter(playerDoc(request.resource.data.playerId)).data.teamId
               == request.resource.data.teamId;

        allow delete: if isTeamAdminOf(resource.data.teamId)
          && (!existsAfter(playerDoc(resource.data.playerId))
              || getAfter(playerDoc(resource.data.playerId)).data.playerKey != key);
      }

      // ---------- settings/playerCounter ----------
      // The next player-ID number. Only moves forward, one at a time,
      // inside the FA's approval transaction.
      function counterDoc() {
        return /databases/$(database)/documents/districts/$(districtId)/settings/playerCounter;
      }

      // The number the next approved player gets (1 if no counter yet)
      function nextNumber() {
        return exists(counterDoc()) ? get(counterDoc()).data.next : 1;
      }

      // 43 in 2026 -> 'GE26-0043'. Must match player_code.dart.
      function playerCodeFor(n) {
        return 'GE' + string(request.time.year() % 100) + '-'
          + (n < 10 ? '000' : (n < 100 ? '00' : (n < 1000 ? '0' : '')))
          + string(n);
      }

      match /settings/playerCounter {
        allow get: if isFaAdmin();
        allow create: if isFaAdmin()
          && request.resource.data.keys().hasOnly(['next'])
          && request.resource.data.next == 2;
        allow update: if isFaAdmin()
          && request.resource.data.keys().hasOnly(['next'])
          && request.resource.data.next == resource.data.next + 1;
      }

      // ---------- Juvenile player IDs (2.14c) ----------

      function juvenileCounterDoc() {
        return /databases/$(database)/documents/districts/$(districtId)/settings/juvenileCounter;
      }

      function nextJuvenileNumber() {
        return exists(juvenileCounterDoc()) ? get(juvenileCounterDoc()).data.next : 1;
      }

      // 1 in 2026 -> 'GJ26-0001'. Must match juvenilePlayerCodeFor.
      function juvenileCodeFor(n) {
        return 'GJ' + string(request.time.year() % 100) + '-'
          + (n < 10 ? '000' : (n < 100 ? '00' : (n < 1000 ? '0' : '')))
          + string(n);
      }

      match /settings/juvenileCounter {
        allow get: if isFaAdmin();
        allow create: if isFaAdmin()
          && request.resource.data.keys().hasOnly(['next'])
          && request.resource.data.next == 2;
        allow update: if isFaAdmin()
          && request.resource.data.keys().hasOnly(['next'])
          && request.resource.data.next == resource.data.next + 1;
      }

      // ---------- FA review of players ----------

      // Approve: status, ID and approval stamp only.
      // - A player who already has an ID (approved before, then edited)
      //   keeps it.
      // - A first approval takes the counter's number, and the counter moves
      //   on by exactly 1 in the same transaction.
      function isPlayerApproval() {
        let before = resource.data;
        let after = request.resource.data;
        return after.status == 'approved'
          && after.diff(before).affectedKeys()
               .hasOnly(['status', 'playerCode', 'approvedAt', 'approvedBy',
                         'rejectionReason', 'updatedAt', 'changes'])
          && !('changes' in after)      // reviewed: the change list is cleared
          && after.approvedBy == request.auth.uid
          && after.approvedAt == request.time
          && after.get('rejectionReason', null) == null
          && ((before.get('playerCode', null) != null
                && after.playerCode == before.playerCode)
              || (before.get('playerCode', null) == null
                && after.playerCode == playerCodeFor(nextNumber())
                && getAfter(counterDoc()).data.next == nextNumber() + 1));
      }

      // Reject: status and a real reason (10 to 500 characters).
      function isPlayerRejection() {
        let after = request.resource.data;
        return after.status == 'rejected'
          && after.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'rejectionReason', 'reviewedAt', 'reviewedBy',
                         'updatedAt', 'changes'])
          && !('changes' in after)      // reviewed: the change list is cleared
          && isText(after.rejectionReason, 10, 500)
          && after.reviewedBy == request.auth.uid
          && after.reviewedAt == request.time;
      }

      // ---------- Juvenile screening decisions (2.14c, board J4) ----------

      // U13 = 0, U15 = 1, U17 = 2: a child may only be moved UP
      function groupIndex(group) {
        return {'U13': 0, 'U15': 1, 'U17': 2}[group];
      }

      function screeningDayDoc(dayId) {
        return /databases/$(database)/documents/districts/$(districtId)/screeningDays/$(dayId);
      }

      // 2.14d: every decision names the screening day it was made on. The
      // day must have STARTED, be at most a day old, and cover the child's
      // age group. So nobody, not even an FA official using the database
      // directly, can screen a child before the day or at home later.
      function isOpenScreeningFor(group) {
        let dayId = request.resource.data.get('screeningDayId', '');
        let day = get(screeningDayDoc(dayId)).data;
        return dayId is string && dayId.size() > 0
          && day.startsAt <= request.time
          && request.time < day.startsAt + duration.value(1, 'd')
          && day.groups.hasAny([group]);
      }

      // Passed: a GJ26-… ID (kept if they had one), in the same group or an
      // older one they still fit, with their jersey reservation in that
      // group (moved in the same transaction).
      function isJuvenilePass(playerId) {
        let before = resource.data;
        let after = request.resource.data;
        return after.status == 'approved'
          && after.diff(before).affectedKeys()
               .hasOnly(['status', 'playerCode', 'approvedAt', 'approvedBy',
                         'rejectionReason', 'updatedAt', 'changes', 'ageGroup',
                         'screeningDayId'])
          && !('changes' in after)
          && isOpenScreeningFor(before.ageGroup)
          && after.approvedBy == request.auth.uid
          && after.approvedAt == request.time
          && after.get('rejectionReason', null) == null
          && groupIndex(after.ageGroup) >= groupIndex(before.ageGroup)
          && isValidAgeGroup(after)
          && getAfter(jerseyDoc(after.teamId, jerseyIdOf(after))).data.playerId == playerId
          && ((before.get('playerCode', null) != null
                && after.playerCode == before.playerCode)
              || (before.get('playerCode', null) == null
                && after.playerCode == juvenileCodeFor(nextJuvenileNumber())
                && getAfter(juvenileCounterDoc()).data.next == nextJuvenileNumber() + 1));
      }

      // Not eligible for Juvenile: rejected for good, with a reason. The
      // team can no longer edit the player, and the player key stays taken,
      // so the child can't be added again in any juvenile group.
      function isJuvenileNotEligible() {
        let after = request.resource.data;
        return after.status == 'rejected'
          && after.notEligible == true
          && after.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'rejectionReason', 'reviewedAt', 'reviewedBy',
                         'updatedAt', 'changes', 'notEligible', 'screeningDayId'])
          && !('changes' in after)
          && isOpenScreeningFor(resource.data.ageGroup)
          && isText(after.rejectionReason, 5, 500)
          && after.reviewedBy == request.auth.uid
          && after.reviewedAt == request.time;
      }

      // Needs correcting (2.14d): back to the team with a reason (blurry
      // photo, a typo…). Not final: the team fixes it and the child waits
      // for screening again.
      function isJuvenileSendBack() {
        let after = request.resource.data;
        return after.status == 'rejected'
          && !('notEligible' in after)
          && after.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'rejectionReason', 'reviewedAt', 'reviewedBy',
                         'updatedAt', 'changes', 'screeningDayId'])
          && !('changes' in after)
          && isOpenScreeningFor(resource.data.ageGroup)
          && isText(after.rejectionReason, 5, 500)
          && after.reviewedBy == request.auth.uid
          && after.reviewedAt == request.time;
      }

      // ---------- squads/{teamId}_{group} (3.1a1) ----------
      // The IDs of a team's APPROVED players, one list per competition:
      // 'division', or a juvenile age group ('U13', 'U15', 'U17'). Team
      // sheets (3.1) check their players against it with ONE lookup
      // instead of one per player (the rules allow only 10 to 20).
      // `changed` names the one player added or taken off by each write.
      function squadGroupOf(player) {
        return player.category == 'juvenile' ? player.ageGroup : 'division';
      }

      function squadDoc(teamId, group) {
        return /databases/$(database)/documents/districts/$(districtId)/squads/$(teamId + '_' + group);
      }

      // After this write, the player is on their squad list
      function inSquadAfter(player, playerId) {
        let path = squadDoc(player.teamId, squadGroupOf(player));
        return existsAfter(path)
          && getAfter(path).data.players.get(playerId, false) == true;
      }

      // After this write, the player is NOT on the list they were on
      function outOfSquadAfter(player, playerId) {
        let path = squadDoc(player.teamId, squadGroupOf(player));
        return !existsAfter(path)
          || getAfter(path).data.players.get(playerId, false) != true;
      }

      // The FA adds exactly one player, approved in this write (or before:
      // repairing a list), of this team and this competition or age group.
      function isSquadAdd(squadId) {
        let after = request.resource.data;
        let before = resource == null ? {} : resource.data.players;
        let player = getAfter(playerDoc(after.changed)).data;
        return after.keys().hasOnly(['teamId', 'group', 'players', 'changed', 'updatedAt'])
          && squadId == after.teamId + '_' + after.group
          && (resource == null
              || (after.teamId == resource.data.teamId && after.group == resource.data.group))
          && after.players is map
          && after.players.diff(before).affectedKeys().hasOnly([after.changed])
          && after.players.diff(before).addedKeys().size() == 1
          && after.players[after.changed] == true
          && after.updatedAt == request.time
          && player.status == 'approved'
          && player.teamId == after.teamId
          && squadGroupOf(player) == after.group;
      }

      // Exactly one player taken off, who is no longer approved after this
      // write (the team sent them back to pending by editing them).
      function isSquadRemoval() {
        let after = request.resource.data;
        let player = getAfter(playerDoc(after.changed)).data;
        return after.diff(resource.data).affectedKeys().hasOnly(['players', 'changed', 'updatedAt'])
          && after.players is map
          && resource.data.players.diff(after.players).affectedKeys().hasOnly([after.changed])
          && resource.data.players.diff(after.players).addedKeys().size() == 1
          && after.updatedAt == request.time
          && player.status != 'approved'
          && player.teamId == resource.data.teamId;
      }

      match /squads/{squadId} {
        // (a list not made yet doesn't exist: a team admin may look, and
        // finds nothing)
        allow read: if isFaAdmin()
          || (resource == null && isTeamAdmin())
          || isTeamAdminOf(resource.data.teamId);
        allow create, update: if isFaAdmin() && isSquadAdd(squadId);
        allow update: if (isFaAdmin() || isTeamAdminOf(resource.data.teamId))
          && isSquadRemoval();
      }

      // ---------- teamSheets/{fixtureId}_{teamId} (3.1a2) ----------
      // A team's sheet for one match: up to 11 starting and, once 11
      // start, up to 7 on the bench (18 at most, League settings). Every
      // player must be on the team's squad list (approved), checked with
      // one lookup per list. Saved again and again until it locks 1 hour
      // before kick-off.

      // The IDs on a squad list ([] when the list doesn't exist yet)
      function squadIds(teamId, group) {
        return exists(squadDoc(teamId, group))
          ? get(squadDoc(teamId, group)).data.players.keys() : [];
      }

      // The players a team may pick for a match: its Division list, or
      // the match's age group and the younger ones (playing up)
      function pickableIds(teamId, fixture) {
        let group = fixture.get('ageGroup', '');
        return fixture.category == 'division'
          ? squadIds(teamId, 'division')
          : (group == 'U13'
              ? squadIds(teamId, 'U13')
              : (group == 'U15'
                  ? squadIds(teamId, 'U13').concat(squadIds(teamId, 'U15'))
                  : squadIds(teamId, 'U13').concat(squadIds(teamId, 'U15'))
                      .concat(squadIds(teamId, 'U17'))));
      }

      function isValidTeamSheet(sheetId, sheet) {
        let fixture = get(fixtureDoc(sheet.fixtureId)).data;
        let starters = sheet.starters;
        let bench = sheet.bench;
        let picked = starters.concat(bench);
        return sheet.keys().hasOnly(['fixtureId', 'teamId', 'category', 'ageGroup',
                                     'starters', 'bench', 'savedBy', 'savedAt'])
          && sheet.keys().hasAll(['fixtureId', 'teamId', 'category',
                                  'starters', 'bench', 'savedBy', 'savedAt'])
          && sheetId == sheet.fixtureId + '_' + sheet.teamId
          && isTeamAdminOf(sheet.teamId)
          && !isSuspended(sheet.teamId)
          // The match: scheduled, ours, not locked yet (1 hour before)
          && fixture.status == 'scheduled'
          && fixture.teamIds.hasAny([sheet.teamId])
          && fixture.kickoffAt != null
          && request.time + duration.value(1, 'h') < fixture.kickoffAt
          && sheet.category == fixture.category
          && sheet.get('ageGroup', null) == fixture.get('ageGroup', null)
          // 7 to 11 starting; a bench only with 11 starting; 18 at most
          && starters is list && bench is list
          && starters.size() >= leagueValue('minPlayers', 7)
          && starters.size() <= 11
          && bench.size() <= 7
          && (bench.size() == 0 || starters.size() == 11)
          && picked.size() <= leagueValue('matchdaySquad', 18)
          && picked.toSet().size() == picked.size()
          // Approved players of this team and competition only
          && pickableIds(sheet.teamId, fixture).hasAll(picked)
          && sheet.savedBy == request.auth.uid
          && sheet.savedAt == request.time;
      }

      match /teamSheets/{sheetId} {
        // The team and the FA (the opponent and officials after the lock: 3.2).
        // A sheet not made yet doesn't exist: a team admin may look.
        allow read: if isFaAdmin()
          || (resource == null && isTeamAdmin())
          || isTeamAdminOf(resource.data.teamId);
        allow create: if isValidTeamSheet(sheetId, request.resource.data);
        allow update: if isValidTeamSheet(sheetId, request.resource.data)
          && request.resource.data.teamId == resource.data.teamId;
      }

      // ---------- players/{playerId} ----------
      match /players/{playerId} {
        allow read: if isTeamAdminOf(resource.data.teamId) || isFaAdmin();

        // The FA approves or rejects a pending Division player, and
        // screens a pending juvenile player (2.14c). An approved player goes
        // on their squad list in the same write (3.1a1).
        allow update: if isFaAdmin()
          && resource.data.status == 'pending'
          && request.resource.data.updatedAt == request.time
          && ((resource.data.category == 'division'
                && ((isPlayerApproval() && inSquadAfter(request.resource.data, playerId))
                    || isPlayerRejection()))
              || (resource.data.category == 'juvenile'
                && ((isJuvenilePass(playerId) && inSquadAfter(request.resource.data, playerId))
                    || isJuvenileNotEligible() || isJuvenileSendBack())));

        // The FA approves a new club name (2.10b): the copy of the team
        // name on every player follows, in the same batch. Nothing else.
        allow update: if isFaAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teamName'])
          && request.resource.data.teamName == getAfter(teamDoc(resource.data.teamId)).data.name;

        // The team adds and edits its own players.
        allow create: if isTeamAdminOf(request.resource.data.teamId)
          // Not while the team is suspended (2.11c)
          && !isSuspended(request.resource.data.teamId)
          // The FA can close player registration (2.13d)
          && leagueValue('playerRegistrationOpen', true) == true
          && isValidPlayer(request.resource.data)
          && hasReservations(request.resource.data, playerId)
          && get(teamDoc(request.resource.data.teamId)).data.categories
               .hasAny([request.resource.data.category])
          && request.resource.data.status == 'pending'
          && !('notEligible' in request.resource.data)
          && !('screeningDayId' in request.resource.data)
          && !('playerCode' in request.resource.data)
          && !('approvedAt' in request.resource.data)
          && !('approvedBy' in request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if isTeamAdminOf(resource.data.teamId)
          && !isSuspended(resource.data.teamId)
          // A child the FA found not eligible can't be edited (2.14c)
          && resource.data.get('notEligible', false) != true
          && !('notEligible' in request.resource.data)
          // The day of the last screening is the FA's to write
          && request.resource.data.get('screeningDayId', null)
               == resource.data.get('screeningDayId', null)
          && isValidPlayer(request.resource.data)
          && hasReservations(request.resource.data, playerId)
          && request.resource.data.teamId == resource.data.teamId
          && request.resource.data.category == resource.data.category
          && request.resource.data.get('playerCode', null) == resource.data.get('playerCode', null)
          && request.resource.data.get('approvedAt', null) == resource.data.get('approvedAt', null)
          && request.resource.data.get('approvedBy', null) == resource.data.get('approvedBy', null)
          && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['reviewedAt', 'reviewedBy'])
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          // An approved player sent back to pending leaves the squad list
          // in the same batch (3.1a1)
          && (resource.data.status != 'approved'
              || request.resource.data.status == 'approved'
              || outOfSquadAfter(resource.data, playerId))
          && (request.resource.data.status == 'pending'
              || (resource.data.status == 'approved'
                  && request.resource.data.status == 'approved'
                  && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['position', 'positionGroup', 'updatedAt'])));
      }
    } // end of districts/{districtId}

    // ---------- Everything else ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}